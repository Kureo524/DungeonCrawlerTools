/* ==========================================================================
   Forge Studio : feuille de style commune.
   Les couleurs de fond suivent le thème de l'éditeur (variables Unity) ;
   les teintes ajoutées sont semi-transparentes pour rester lisibles en clair comme en sombre.
   ========================================================================== */

:root {
    --forge-accent: rgb(232, 160, 90);
    --forge-accent-soft: rgba(232, 160, 90, 0.18);
    --forge-accent-strong: rgba(232, 160, 90, 0.35);
    --forge-card: rgba(128, 128, 128, 0.07);
    --forge-card-hover: rgba(128, 128, 128, 0.14);
    --forge-line: rgba(128, 128, 128, 0.22);
    --forge-muted: rgba(128, 128, 128, 0.9);
    --forge-critical: rgb(208, 59, 59);
    --forge-warning: rgb(250, 178, 25);
    --forge-good: rgb(12, 163, 12);
}

/* ---------- Structure : barre latérale + zone principale ---------- */

.forge-studio {
    flex-grow: 1;
    flex-direction: row;
}

.forge-sidebar {
    width: 210px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: var(--forge-line);
    background-color: rgba(0, 0, 0, 0.08);
}

.forge-sidebar__brand {
    padding: 14px 14px 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--forge-line);
}

.forge-sidebar__logo {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: var(--forge-accent);
}

.forge-sidebar__tagline {
    font-size: 10px;
    opacity: 0.65;
    white-space: normal;
}

.forge-sidebar__group {
    margin: 14px 14px 4px 14px;
    font-size: 9px;
    letter-spacing: 1.5px;
    -unity-font-style: bold;
    opacity: 0.5;
}

.forge-nav {
    flex-direction: row;
    align-items: center;
    height: 32px;
    margin: 1px 6px;
    padding: 0 8px 0 0;
    border-radius: 6px;
    transition-property: background-color, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.forge-nav:hover {
    background-color: var(--forge-card-hover);
    translate: 2px 0;
}

.forge-nav--active,
.forge-nav--active:hover {
    background-color: var(--forge-accent-soft);
    translate: 0 0;
}

.forge-nav__indicator {
    width: 3px;
    height: 18px;
    margin-right: 7px;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color, height;
    transition-duration: 0.2s;
}

.forge-nav--active .forge-nav__indicator {
    background-color: var(--forge-accent);
    height: 22px;
}

.forge-nav__icon {
    width: 22px;
    height: 22px;
    margin-right: 8px;
}

.forge-nav__label {
    flex-grow: 1;
}

.forge-nav--active .forge-nav__label {
    -unity-font-style: bold;
}

.forge-nav__count {
    min-width: 22px;
    padding: 1px 6px;
    border-radius: 9px;
    font-size: 10px;
    -unity-text-align: middle-center;
    background-color: var(--forge-card-hover);
}

.forge-nav__dot {
    display: none;
    width: 8px;
    height: 8px;
    margin-right: 5px;
    border-radius: 4px;
    background-color: var(--forge-critical);
}

.forge-sidebar__status {
    margin: 8px;
    padding: 8px;
    border-radius: 6px;
    font-size: 11px;
    white-space: normal;
    background-color: var(--forge-card);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.forge-sidebar__status:hover {
    background-color: var(--forge-card-hover);
}

.forge-main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.forge-main__header {
    flex-direction: row;
    align-items: center;
    padding: 10px 14px;
    border-bottom-width: 1px;
    border-bottom-color: var(--forge-line);
}

.forge-main__icon {
    width: 36px;
    height: 36px;
    margin-right: 12px;
    padding: 4px;
    border-radius: 8px;
    background-color: var(--forge-accent-soft);
}

.forge-title {
    font-size: 17px;
    -unity-font-style: bold;
}

.forge-subtitle {
    opacity: 0.7;
    white-space: normal;
}

.forge-help-toggle {
    height: 26px;
    padding: 0 12px;
    border-radius: 13px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.forge-help-toggle--active {
    background-color: var(--forge-accent-strong);
}

.forge-main__body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.forge-tab-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.forge-tab-content > * {
    flex-grow: 1;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out;
}

.forge-tab-content > .forge-fade {
    opacity: 0;
    translate: 0 6px;
}

.forge-help-drawer {
    width: 310px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: var(--forge-line);
    background-color: rgba(0, 0, 0, 0.05);
}

/* ---------- Cartes et grilles ---------- */

.forge-card {
    margin: 5px;
    padding: 10px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--forge-line);
    background-color: var(--forge-card);
    transition-property: background-color, border-color, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.forge-card--clickable:hover {
    background-color: var(--forge-card-hover);
    border-color: var(--forge-accent);
    translate: 0 -2px;
}

.forge-card-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}

.forge-card-grid > .forge-card {
    flex-grow: 1;
    flex-basis: 220px;
}

.forge-card-grid > .forge-card--wide {
    flex-basis: 420px;
}

.forge-dashboard {
    padding: 8px 12px 16px 12px;
}

.forge-dashboard__heading {
    margin: 14px 6px 4px 6px;
    font-size: 13px;
    -unity-font-style: bold;
}

.forge-progress-card {
    flex-direction: row;
    align-items: center;
}

.forge-progress-card__ring {
    margin-right: 12px;
    flex-shrink: 0;
}

.forge-progress-card__title {
    -unity-font-style: bold;
    opacity: 0.85;
}

.forge-progress-card__value {
    font-size: 20px;
    -unity-font-style: bold;
}

.forge-progress-card__caption {
    font-size: 10px;
    opacity: 0.6;
}

.forge-progress-card__status {
    font-size: 10px;
    -unity-font-style: bold;
}

.forge-progress-card__status--error {
    color: var(--forge-critical);
}

.forge-progress-card__status--good {
    color: var(--forge-good);
}

.forge-stat {
    border-left-width: 4px;
}

.forge-stat--critical {
    border-left-color: var(--forge-critical);
}

.forge-stat--warning {
    border-left-color: var(--forge-warning);
}

.forge-stat--good {
    border-left-color: var(--forge-good);
}

.forge-stat__icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.forge-stat__title {
    opacity: 0.75;
}

.forge-stat__value {
    font-size: 26px;
    -unity-font-style: bold;
    margin-top: 2px;
}

/* ---------- Graphiques ---------- */

.forge-chart {
    flex-grow: 1;
    min-width: 200px;
}

.forge-chart__title {
    -unity-font-style: bold;
    margin-bottom: 4px;
    opacity: 0.85;
    white-space: normal;
}

.forge-chart__plot {
    position: relative;
    min-height: 90px;
}

.forge-chart__labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.forge-chart__axis-label {
    position: absolute;
    font-size: 9px;
    opacity: 0.6;
    padding: 0;
    margin: 0;
}

.forge-chart__axis-label--y {
    left: 0;
    -unity-text-align: middle-right;
}

.forge-chart__axis-label--x {
    width: 40px;
    -unity-text-align: upper-center;
}

.forge-chart__tooltip {
    display: none;
    position: absolute;
    padding: 5px 8px;
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--forge-line);
    background-color: var(--unity-colors-window-background, rgb(56, 56, 56));
    font-size: 11px;
    white-space: nowrap;
}

.forge-chart__legend {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 4px;
}

.forge-chart__legend-item {
    flex-direction: row;
    align-items: center;
    margin-right: 12px;
}

.forge-chart__legend-item Label {
    font-size: 10px;
    opacity: 0.85;
}

.forge-chart__swatch {
    width: 10px;
    height: 10px;
    margin-right: 5px;
    border-radius: 3px;
    flex-shrink: 0;
}

.forge-small-multiples {
    flex-direction: row;
    flex-wrap: wrap;
}

.forge-small-multiples > .forge-chart {
    flex-basis: 220px;
    margin: 4px 6px;
}

.forge-chart-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.forge-chart-row > .forge-chart {
    flex-grow: 0;
    margin-right: 16px;
}

.forge-chart-row__grow {
    flex-grow: 1;
    flex-basis: 260px;
}

.forge-donut {
    flex-direction: row;
    align-items: center;
}

.forge-donut__ring {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.forge-donut__center {
    align-items: center;
}

.forge-donut__value {
    font-size: 18px;
    -unity-font-style: bold;
}

.forge-donut__caption {
    font-size: 9px;
    opacity: 0.6;
}

.forge-donut__legend {
    margin-left: 12px;
    min-width: 130px;
}

.forge-donut__legend-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 4px;
    border-radius: 4px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.forge-donut__legend-row--hover {
    background-color: var(--forge-card-hover);
}

.forge-donut__legend-label {
    flex-grow: 1;
    font-size: 11px;
}

.forge-donut__legend-value {
    font-size: 11px;
    margin-left: 8px;
}

.forge-meter {
    margin: 4px 0 6px 0;
}

.forge-meter__title {
    flex-grow: 1;
    opacity: 0.8;
}

.forge-meter__track {
    height: 10px;
    margin: 3px 0 1px 0;
    border-radius: 5px;
    background-color: rgba(128, 128, 128, 0.18);
}

.forge-meter__band {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 5px;
    background-color: rgba(12, 163, 12, 0.3);
    transition-property: left, width;
    transition-duration: 0.3s;
}

.forge-meter__marker {
    position: absolute;
    top: -3px;
    width: 4px;
    height: 16px;
    margin-left: -2px;
    border-radius: 2px;
    transition-property: left, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.forge-meter__scale {
    font-size: 9px;
    opacity: 0.5;
}

/* Barres horizontales */

.forge-bar-row {
    flex-direction: row;
    align-items: center;
    height: 22px;
    padding: 0 4px;
    border-radius: 4px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.forge-bar-row:hover {
    background-color: var(--forge-card-hover);
}

.forge-bar-row__icon {
    width: 18px;
    height: 18px;
    margin-right: 4px;
}

.forge-bar-row__label {
    width: 150px;
    overflow: hidden;
    white-space: nowrap;
}

.forge-bar-row__track {
    flex-grow: 1;
    height: 10px;
    border-radius: 4px;
    background-color: rgba(128, 128, 128, 0.15);
}

.forge-bar-row__fill {
    height: 100%;
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-cubic;
}

.forge-bar-row__value {
    width: 96px;
    -unity-text-align: middle-right;
    font-size: 11px;
}

/* ---------- Liste + fiche ---------- */

.forge-list-pane {
    min-width: 190px;
    padding: 6px;
}

.forge-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 2px 0 6px 0;
}

.forge-list-item {
    flex-direction: row;
    align-items: center;
    padding: 0 4px;
    border-radius: 4px;
}

.forge-list-item__icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
}

.forge-list-item__strip {
    width: 4px;
    height: 18px;
    margin-right: 6px;
    border-radius: 2px;
}

.forge-list-item__label {
    flex-grow: 1;
}

.forge-list-item__warning {
    -unity-font-style: bold;
}

.forge-details-pane {
    flex-grow: 1;
    flex-direction: column;
}

.forge-details {
    padding: 8px 12px;
}

.forge-details-header {
    flex-direction: row;
    align-items: center;
    margin: 2px 0 8px 0;
    padding: 10px;
    border-radius: 8px;
    background-color: var(--forge-card);
}

.forge-preview {
    width: 64px;
    height: 64px;
    margin-right: 12px;
    border-width: 1px;
    border-color: var(--forge-line);
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.15);
}

.forge-details-title {
    font-size: 15px;
    -unity-font-style: bold;
}

.forge-section {
    margin: 6px 0;
    padding: 8px 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--forge-line);
    background-color: var(--forge-card);
}

.forge-section-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
    opacity: 0.85;
}

.forge-row {
    flex-direction: row;
    align-items: center;
}

.forge-row > .unity-base-field {
    flex-grow: 1;
}

.forge-button {
    margin: 1px 2px;
    border-radius: 4px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.forge-button--primary {
    background-color: rgba(90, 170, 90, 0.45);
}

.forge-button--primary:hover {
    background-color: rgba(90, 170, 90, 0.65);
}

.forge-button--danger {
    background-color: rgba(200, 70, 70, 0.35);
}

.forge-button--danger:hover {
    background-color: rgba(200, 70, 70, 0.55);
}

.forge-button--blocked {
    background-color: rgba(200, 70, 70, 0.35);
}

.forge-button--icon {
    width: 22px;
    padding: 0;
}

.forge-badge {
    padding: 1px 7px;
    margin: 2px 4px 2px 0;
    border-radius: 8px;
    color: rgb(20, 20, 20);
    -unity-font-style: bold;
    font-size: 10px;
}

.forge-multiline TextInput {
    min-height: 48px;
    white-space: normal;
}

.forge-empty {
    padding: 24px;
    opacity: 0.6;
    -unity-text-align: middle-center;
    white-space: normal;
}

.forge-hint {
    opacity: 0.6;
    -unity-font-style: italic;
    white-space: normal;
    margin: 2px 0;
}

.forge-array-row {
    flex-direction: row;
    align-items: center;
    padding: 2px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.12);
}

.forge-table-row {
    flex-direction: row;
    align-items: center;
}

.forge-table-row > * {
    width: 90px;
    margin: 1px 2px;
}

.forge-table-row > .forge-table-wide {
    flex-grow: 1;
    width: auto;
}

.forge-table-header {
    -unity-font-style: bold;
    opacity: 0.8;
}

/* ---------- Problèmes détectés ---------- */

.forge-issue {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    margin: 2px 0;
    border-left-width: 3px;
    border-radius: 4px;
    transition-property: background-color, translate;
    transition-duration: 0.12s;
}

.forge-issue:hover {
    translate: 2px 0;
}

.forge-issue Label {
    white-space: normal;
    flex-shrink: 1;
}

.forge-issue--error {
    border-left-color: var(--forge-critical);
    background-color: rgba(208, 59, 59, 0.12);
}

.forge-issue--warning {
    border-left-color: var(--forge-warning);
    background-color: rgba(250, 178, 25, 0.12);
}

.forge-issue--ok {
    border-left-color: var(--forge-good);
    background-color: rgba(12, 163, 12, 0.12);
}

/* ---------- Pied de validation ---------- */

.forge-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 8px 12px;
    border-top-width: 1px;
    border-top-color: var(--forge-line);
    background-color: rgba(0, 0, 0, 0.08);
}

.forge-footer__icon {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

.forge-footer__status {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.forge-footer__commit {
    min-width: 180px;
    height: 28px;
    border-radius: 14px;
    -unity-font-style: bold;
}

/* ---------- Sélecteurs ---------- */

.forge-picker__preview {
    width: 20px;
    height: 20px;
    margin-right: 4px;
}

.forge-sprite-field {
    margin: 2px 0;
}

.forge-sprite-field__label {
    min-width: 120px;
}

.forge-sprite-field__preview {
    width: 40px;
    height: 40px;
    margin-right: 6px;
    border-width: 1px;
    border-color: var(--forge-line);
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.2);
    transition-property: border-color;
    transition-duration: 0.12s;
}

.forge-sprite-field__preview:hover {
    border-color: var(--forge-accent);
}

.forge-sprite-field__name {
    flex-grow: 1;
    opacity: 0.8;
}

.forge-gallery {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 6px;
}

.forge-gallery__cell {
    width: 84px;
    height: 84px;
    margin: 3px;
    padding: 4px;
    align-items: center;
    border-radius: 6px;
    background-color: rgba(128, 128, 128, 0.12);
    transition-property: background-color, scale;
    transition-duration: 0.12s;
}

.forge-gallery__cell:hover {
    background-color: var(--forge-accent-strong);
    scale: 1.05 1.05;
}

.forge-gallery__cell Image {
    width: 52px;
    height: 52px;
}

.forge-gallery__cell Label {
    font-size: 9px;
    overflow: hidden;
    -unity-text-align: middle-center;
}

/* ---------- Biomes ---------- */

.forge-tile-preview {
    align-self: flex-start;
    margin: 4px 0;
    border-width: 1px;
    border-color: var(--forge-line);
    border-radius: 4px;
    overflow: hidden;
}

.forge-tile-preview__cell {
    width: 32px;
    height: 32px;
}

.forge-tile-preview__cell--missing {
    background-color: rgba(208, 59, 59, 0.4);
}

/* ---------- Salles ---------- */

.forge-room-layout {
    flex-direction: row;
    align-items: flex-start;
}

.forge-room-properties {
    width: 330px;
    flex-shrink: 0;
    margin-right: 8px;
}

.forge-room-editor {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-start;
    min-height: 420px;
}

.forge-palette-scroll {
    width: 196px;
    max-height: 640px;
    flex-shrink: 0;
    margin-right: 8px;
}

.forge-palette__title {
    -unity-font-style: bold;
    margin: 6px 0 2px 0;
    opacity: 0.85;
}

.forge-palette__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.forge-palette__brush {
    width: 58px;
    height: 60px;
    margin: 2px;
    padding: 2px;
    align-items: center;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    background-color: rgba(128, 128, 128, 0.12);
    transition-property: background-color, border-color, scale;
    transition-duration: 0.12s;
}

.forge-palette__brush:hover {
    background-color: rgba(128, 128, 128, 0.28);
    scale: 1.05 1.05;
}

.forge-palette__brush--selected {
    border-color: var(--forge-accent);
    background-color: var(--forge-accent-soft);
}

.forge-palette__icon {
    width: 32px;
    height: 32px;
}

.forge-palette__brush Label {
    font-size: 9px;
    overflow: hidden;
    -unity-text-align: middle-center;
    white-space: nowrap;
    max-width: 54px;
}

.forge-canvas-scroll {
    flex-grow: 1;
    max-height: 680px;
}

.forge-canvas__grid {
    border-width: 2px;
    border-color: var(--forge-line);
    border-radius: 4px;
}

.forge-canvas__row {
    flex-direction: row;
}

.forge-canvas__cell {
    border-width: 0;
}

.forge-canvas__cell > Image {
    width: 100%;
    height: 100%;
}

.forge-canvas__cell--door {
    border-width: 2px;
    border-color: var(--forge-good);
}

.forge-canvas__cell--boss {
    border-width: 2px;
    border-color: var(--forge-critical);
}

.forge-canvas__cell--unreachable {
    -unity-background-image-tint-color: rgb(255, 120, 120);
    background-color: rgba(208, 59, 59, 0.45);
}

.forge-canvas__status {
    margin-top: 4px;
    opacity: 0.8;
    white-space: normal;
}

.forge-door-picker {
    align-items: center;
}

.forge-door-picker .forge-row {
    justify-content: space-between;
    width: 100%;
}

.forge-door-toggle {
    margin: 2px 8px;
}

.forge-door-toggle Label {
    min-width: 40px;
}

/* ---------- Aide ---------- */

.forge-help {
    padding: 12px 16px;
}

.forge-help-h1 {
    font-size: 15px;
    -unity-font-style: bold;
    margin: 4px 0;
}

.forge-help-h2 {
    font-size: 12px;
    -unity-font-style: bold;
    margin: 10px 0 2px 0;
    color: var(--forge-accent);
}

.forge-help-text,
.forge-help-bullet {
    white-space: normal;
    margin: 1px 0;
}

.forge-help-bullet {
    margin-left: 10px;
}

/* ---------- Étages ---------- */

.forge-floor-side {
    width: 230px;
    flex-shrink: 0;
    margin-right: 10px;
}

.forge-floor-side .forge-palette-scroll {
    width: auto;
    max-height: 420px;
    margin-right: 0;
}

.forge-floor-room {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
    padding: 4px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    background-color: var(--forge-card);
    transition-property: background-color, border-color, translate;
    transition-duration: 0.12s;
}

.forge-floor-room:hover {
    background-color: var(--forge-card-hover);
    translate: 2px 0;
}

.forge-floor-room--selected {
    border-color: var(--forge-accent);
    background-color: var(--forge-accent-soft);
}

.forge-floor-room--placed {
    opacity: 0.55;
}

.forge-floor-room__mini {
    width: 44px;
    height: 32px;
    margin-right: 8px;
    flex-shrink: 0;
}

.forge-floor-room__detail {
    font-size: 10px;
    opacity: 0.65;
}

.forge-floor__board {
    position: relative;
    border-radius: 6px;
    background-color: rgba(0, 0, 0, 0.12);
}

.forge-floor__labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.forge-floor__room-name {
    position: absolute;
    font-size: 10px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.forge-floor__tag {
    position: absolute;
    padding: 0 5px;
    border-radius: 6px;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

/* ---------- Dialogues ---------- */

.forge-view-switch {
    flex-direction: row;
    margin: 8px 0 4px 0;
    padding: 3px;
    align-self: flex-start;
    border-radius: 16px;
    background-color: var(--forge-card);
}

.forge-view-switch__button {
    height: 26px;
    padding: 0 14px;
    margin: 0 2px;
    border-width: 0;
    border-radius: 13px;
    background-color: rgba(0, 0, 0, 0);
}

.forge-view-switch__button--active {
    background-color: var(--forge-accent-strong);
    -unity-font-style: bold;
}

.forge-stat--compact .forge-stat__value {
    font-size: 18px;
}

.forge-card-grid > .forge-stat--compact {
    flex-basis: 140px;
}

.forge-dialogue-layout {
    flex-direction: row;
    align-items: stretch;
    min-height: 560px;
}

.forge-dialogue-layout__chat {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 320px;
    margin-right: 10px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--forge-line);
    background-color: rgba(0, 0, 0, 0.12);
}

.forge-dialogue-layout__side {
    width: 380px;
    flex-shrink: 0;
    max-height: 700px;
}

.forge-chat {
    flex-grow: 1;
}

.forge-chat__thread {
    height: 470px;
    padding: 10px;
}

.forge-chat__block {
    margin-bottom: 10px;
}

.forge-chat__line {
    flex-direction: row;
    align-items: flex-end;
}

.forge-chat__line--player {
    justify-content: flex-end;
}

.forge-chat__line--narrator {
    justify-content: center;
}

.forge-chat__avatar {
    width: 38px;
    height: 38px;
    margin-right: 8px;
    border-radius: 19px;
    border-width: 2px;
    background-color: rgba(0, 0, 0, 0.25);
    flex-shrink: 0;
}

.forge-chat__bubble {
    max-width: 78%;
    padding: 7px 11px;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--forge-card-hover);
    transition-property: border-color, translate, background-color;
    transition-duration: 0.12s;
}

.forge-chat__line--npc .forge-chat__bubble {
    border-bottom-left-radius: 3px;
}

.forge-chat__line--player .forge-chat__bubble {
    border-bottom-right-radius: 3px;
    background-color: rgba(27, 175, 122, 0.3);
}

.forge-chat__line--narrator .forge-chat__bubble {
    background-color: rgba(128, 128, 128, 0.1);
    border-color: var(--forge-line);
}

.forge-chat__bubble:hover {
    translate: 0 -1px;
    border-color: rgba(232, 160, 90, 0.5);
}

.forge-chat__bubble--selected,
.forge-chat__bubble--selected:hover {
    border-color: var(--forge-accent);
}

.forge-chat__meta {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

.forge-chat__speaker {
    font-size: 10px;
    -unity-font-style: bold;
    opacity: 0.8;
    margin-right: 6px;
}

.forge-chat__id {
    font-size: 9px;
    opacity: 0.5;
    margin-right: 6px;
}

.forge-chat__text {
    white-space: normal;
    font-size: 12px;
}

.forge-chat__line--narrator .forge-chat__text {
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

.forge-chat__text--empty {
    opacity: 0.5;
    -unity-font-style: italic;
}

.forge-chat__replies {
    align-items: flex-end;
    margin: 4px 0 0 46px;
}

.forge-chat__reply {
    max-width: 75%;
    margin: 2px 0;
    padding: 5px 10px;
    border-radius: 12px;
    border-bottom-right-radius: 3px;
    border-width: 1px;
    border-color: rgba(27, 175, 122, 0.6);
    background-color: rgba(27, 175, 122, 0.16);
    transition-property: background-color, translate;
    transition-duration: 0.12s;
}

.forge-chat__reply:hover {
    background-color: rgba(27, 175, 122, 0.32);
    translate: -2px 0;
}

.forge-chat__reply-text {
    white-space: normal;
}

.forge-chat__chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 3px;
}

.forge-chat__system {
    align-self: center;
    margin: 4px 0;
    padding: 2px 10px;
    border-radius: 10px;
    font-size: 10px;
    opacity: 0.65;
    background-color: rgba(128, 128, 128, 0.12);
}

.forge-chat__jump {
    align-self: flex-start;
    margin: 2px 0 0 46px;
    font-size: 10px;
    color: var(--forge-accent);
}

.forge-chip {
    padding: 1px 6px;
    margin: 1px 3px 1px 0;
    border-radius: 7px;
    font-size: 9px;
    -unity-font-style: bold;
}

.forge-chip--condition {
    background-color: rgba(98, 80, 214, 0.35);
}

.forge-chip--effect {
    background-color: rgba(237, 161, 0, 0.3);
}

.forge-chip--target {
    background-color: rgba(128, 128, 128, 0.25);
}

.forge-chip--start {
    background-color: rgba(12, 163, 12, 0.35);
}

.forge-composer {
    padding: 8px;
    border-top-width: 1px;
    border-top-color: var(--forge-line);
}

.forge-composer__speakers {
    flex-direction: row;
    margin-bottom: 4px;
}

.forge-composer__speaker {
    border-radius: 11px;
    padding: 1px 10px;
}

.forge-composer__speaker--active {
    background-color: var(--forge-accent-strong);
    -unity-font-style: bold;
}

.forge-composer__input {
    flex-grow: 1;
}

.forge-composer__input TextInput {
    min-height: 26px;
    border-radius: 13px;
    padding-left: 10px;
}

.forge-dialogue-inspector {
    padding: 8px 10px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--forge-line);
    background-color: var(--forge-card);
}

.forge-dialogue-inspector__text TextInput {
    min-height: 70px;
}

.forge-dialogue-inspector__counter {
    font-size: 10px;
    opacity: 0.6;
    -unity-text-align: middle-right;
}

.forge-dialogue-inspector__counter--over {
    color: var(--forge-critical);
    opacity: 1;
    -unity-font-style: bold;
}

.forge-dialogue-choice {
    flex-grow: 1;
    padding: 4px 0;
}

.forge-dialogue-choice__rules {
    margin-left: 4px;
}

.forge-rule-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.forge-rule-row__type {
    width: 150px;
    flex-shrink: 0;
}

.forge-rule-row__value {
    flex-direction: row;
    flex-grow: 1;
}

.forge-rule-row__value > * {
    flex-grow: 1;
}

.forge-dialogue-graph__scroll {
    height: 560px;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0.12);
}

.forge-dialogue-graph__canvas {
    position: relative;
}

.forge-dialogue-graph__edges {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.forge-dialogue-graph__box {
    position: absolute;
    flex-direction: row;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--forge-line);
    background-color: var(--unity-colors-window-background, rgb(56, 56, 56));
    overflow: hidden;
    transition-property: border-color, translate;
    transition-duration: 0.12s;
}

.forge-dialogue-graph__box:hover {
    border-color: rgba(232, 160, 90, 0.6);
    translate: 0 -2px;
}

.forge-dialogue-graph__box--selected {
    border-color: var(--forge-accent);
}

.forge-dialogue-graph__box--orphan {
    border-color: var(--forge-warning);
}

.forge-dialogue-graph__box Label {
    font-size: 10px;
}

.forge-dialogue-graph__stripe {
    width: 5px;
    margin-right: 6px;
}

.forge-dialogue-graph__text {
    white-space: normal;
    opacity: 0.8;
}

.forge-dialogue-graph__edge-label {
    position: absolute;
    width: 80px;
    font-size: 9px;
    -unity-text-align: middle-center;
    padding: 1px 3px;
    border-radius: 6px;
    background-color: var(--unity-colors-window-background, rgb(56, 56, 56));
    overflow: hidden;
    white-space: nowrap;
}

/* Aperçu en jeu */

.forge-preview-game {
    flex-direction: row;
    align-items: flex-start;
}

.forge-preview-game__left {
    flex-grow: 1;
    margin-right: 10px;
}

.forge-preview-game__right {
    width: 280px;
    flex-shrink: 0;
    padding: 8px 10px;
    border-radius: 10px;
    background-color: var(--forge-card);
}

.forge-preview-game__screen {
    height: 420px;
    justify-content: space-between;
    padding: 12px;
    border-radius: 10px;
    border-width: 3px;
    border-color: rgb(25, 25, 30);
    background-color: rgb(32, 28, 36);
    background-size: 64px 64px;
    background-repeat: repeat repeat;
    -unity-background-image-tint-color: rgb(110, 110, 120);
}

.forge-preview-game__hud {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: 8px;
    font-size: 11px;
    color: rgb(235, 235, 235);
    background-color: rgba(0, 0, 0, 0.6);
}

.forge-preview-game__box {
    flex-direction: row;
    min-height: 140px;
    padding: 10px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(200, 180, 140);
    background-color: rgba(14, 12, 18, 0.92);
}

.forge-preview-game__portrait {
    width: 96px;
    height: 96px;
    margin-right: 12px;
    border-radius: 6px;
    border-width: 2px;
    border-color: rgb(200, 180, 140);
    background-color: rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
}

.forge-preview-game__content {
    flex-grow: 1;
    flex-shrink: 1;
}

.forge-preview-game__name {
    align-self: flex-start;
    padding: 1px 10px;
    margin-bottom: 4px;
    border-radius: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.forge-preview-game__text {
    white-space: normal;
    font-size: 14px;
    color: rgb(240, 236, 228);
    min-height: 44px;
}

.forge-preview-game__text--narration {
    -unity-font-style: italic;
    color: rgb(200, 195, 185);
}

.forge-preview-game__choices {
    margin-top: 6px;
}

.forge-preview-game__choice {
    -unity-text-align: middle-left;
    margin: 2px 0;
    padding: 4px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(200, 180, 140, 0.5);
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(240, 236, 228);
    transition-property: background-color, translate;
    transition-duration: 0.1s;
}

.forge-preview-game__choice:hover {
    background-color: rgba(200, 180, 140, 0.25);
    translate: 4px 0;
}

.forge-preview-game__prompt {
    margin-top: 6px;
    font-size: 10px;
    color: rgb(200, 180, 140);
    -unity-text-align: middle-right;
}

.forge-preview-game__journal {
    height: 200px;
    margin-top: 4px;
}

.forge-journal {
    white-space: normal;
    font-size: 10px;
    margin: 1px 0;
    padding: 2px 6px;
    border-left-width: 3px;
    border-radius: 3px;
}

.forge-journal--line {
    border-left-color: rgba(128, 128, 128, 0.6);
}

.forge-journal--player {
    border-left-color: rgb(27, 175, 122);
}

.forge-journal--effect {
    border-left-color: rgb(237, 161, 0);
    background-color: rgba(237, 161, 0, 0.12);
}

.forge-journal--system {
    opacity: 0.6;
    -unity-font-style: italic;
    border-left-color: rgba(0, 0, 0, 0);
}

.forge-journal--error {
    border-left-color: var(--forge-critical);
    background-color: rgba(208, 59, 59, 0.15);
}
