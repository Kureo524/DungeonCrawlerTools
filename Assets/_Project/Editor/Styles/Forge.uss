/* ==========================================================================
   Forge Studio : système de design « Verre d'encre »
   - Un seul skin, sombre (« Encre ») : encre bleu nuit, blancs froids, teintes fines de lavande et de vert.
   - La navigation et les panneaux sont en verre : fond translucide au-dessus d'un ciel de constellations,
     liseré clair en haut et à gauche (la lumière vient de là). Voir la fin du fichier.
   - Une seule couleur d'accent (bleu froid) ; rouge, jaune et vert réservés aux états.
   - Rayons fixes (Unity dessine une ellipse au-delà de la moitié de la hauteur) : 6 (étiquettes), 10 (boutons, champs),
     14 (lignes), 16 (barre de validation), 18 (sections), 22 (navigation).
   ========================================================================== */

/* ---------- Jetons de couleur ---------- */

.forge-theme--dark,
.forge-theme--light {
    --forge-bg: #0e0e13;
    --forge-bg-sidebar: rgba(30, 30, 40, 0.42);
    --forge-surface: rgba(22, 22, 30, 0.62);
    --forge-surface-raised: rgba(232, 238, 250, 0.06);
    --forge-hover: rgba(232, 238, 250, 0.06);
    --forge-border: rgba(232, 238, 250, 0.09);
    --forge-border-strong: rgba(232, 238, 250, 0.17);
    --forge-rim: rgba(232, 238, 250, 0.24);
    --forge-input: rgba(10, 10, 15, 0.62);
    --forge-text: #e8eefa;
    --forge-text-2: #a3a6b6;
    --forge-text-3: #8a8a9c;
    --forge-accent: #8aa8e0;
    --forge-accent-hover: #9dbdff;
    --forge-accent-soft: rgba(138, 168, 224, 0.16);
    --forge-accent-text: #a9c4f0;
    --forge-accent-tint: rgba(138, 168, 224, 0.50);
    --forge-lavender: #a597c0;
    --forge-lavender-soft: rgba(165, 151, 192, 0.16);
    --forge-success: #9ebd85;
    --forge-success-soft: rgba(158, 189, 133, 0.14);
    --forge-warning: #e7b52f;
    --forge-warning-soft: rgba(231, 181, 47, 0.12);
    --forge-danger: #e0606a;
    --forge-danger-soft: rgba(224, 96, 106, 0.13);
    --forge-canvas: rgba(10, 10, 15, 0.72);
}

/* ---------- Base : texte, champs, boutons ---------- */

.forge-theme {
    flex-grow: 1;
    background-color: var(--forge-bg);
    font-size: 12px;
}

.forge-theme Label {
    color: var(--forge-text);
}

.forge-theme .unity-base-field__label {
    color: var(--forge-text-2);
    min-width: 120px;
}

.forge-theme .unity-base-text-field__input,
.forge-theme .unity-base-popup-field__input,
.forge-theme .unity-object-field__input {
    min-height: 24px;
    padding: 2px 8px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--forge-border);
    background-color: var(--forge-input);
    color: var(--forge-text);
    transition-property: border-color;
    transition-duration: 0.12s;
}

.forge-theme .unity-base-text-field__input:hover,
.forge-theme .unity-base-popup-field__input:hover,
.forge-theme .unity-object-field__input:hover {
    border-color: var(--forge-border-strong);
}

.forge-theme .unity-base-text-field__input:focus,
.forge-theme .unity-base-field:focus > .unity-base-text-field__input {
    border-color: var(--forge-accent);
}

.forge-theme .unity-base-field {
    margin: 3px 0;
}

.forge-theme .unity-button {
    min-height: 26px;
    margin: 2px 4px 2px 0;
    padding: 0 12px;
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
    color: var(--forge-text);
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.forge-theme .unity-button:hover {
    border-color: var(--forge-border-strong);
    background-color: var(--forge-surface);
}

.forge-theme .unity-button:active {
    background-color: var(--forge-hover);
}

.forge-theme .forge-button--primary {
    border-color: var(--forge-accent);
    background-color: var(--forge-accent);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.forge-theme .forge-button--primary:hover {
    border-color: var(--forge-accent-hover);
    background-color: var(--forge-accent-hover);
}

.forge-theme .forge-button--danger {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-danger);
}

.forge-theme .forge-button--danger:hover {
    border-color: var(--forge-danger-soft);
    background-color: var(--forge-danger-soft);
}

.forge-theme .forge-button--blocked {
    border-color: var(--forge-danger);
    background-color: var(--forge-danger-soft);
    color: var(--forge-danger);
}

.forge-theme .forge-button--icon {
    width: 26px;
    padding: 0;
    -unity-text-align: middle-center;
}

.forge-theme .unity-toolbar-search-field {
    margin: 6px 0 8px 0;
    border-radius: 6px;
}

.forge-theme .unity-foldout__text {
    color: var(--forge-text);
    -unity-font-style: bold;
}

.forge-theme .unity-two-pane-split-view__dragline-anchor {
    background-color: var(--forge-border);
}

.forge-theme .unity-collection-view__item:hover {
    background-color: var(--forge-hover);
}

.forge-theme .unity-collection-view__item--selected,
.forge-theme .unity-collection-view__item--selected:hover {
    background-color: var(--forge-accent-soft);
}

.forge-row {
    flex-direction: row;
    align-items: center;
}

.forge-row > .unity-base-field {
    flex-grow: 1;
}

.forge-hint {
    font-size: 11px;
    white-space: normal;
    margin: 2px 0 6px 0;
}

.forge-theme .forge-hint {
    color: var(--forge-text-3);
}

.forge-empty {
    padding: 40px 24px;
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.forge-theme .forge-empty {
    color: var(--forge-text-3);
}

/* ---------- Contenu qui s'adapte à son texte ----------
   Textes libres : retour à la ligne et hauteur qui grandit avec le contenu.
   Libellés courts (listes déroulantes, noms, compteurs) : une ligne, coupée par des points de suspension. */

.forge-multiline .unity-base-text-field__input {
    min-height: 56px;
    height: auto;
    -unity-text-align: middle-left;
}

.forge-multiline .unity-base-text-field__input > .unity-text-element {
    -unity-text-align: middle-left;
}

.forge-multiline .unity-text-element,
.forge-wrap .unity-text-element,
.forge-wrap .unity-base-text-field__input {
    white-space: normal;
}

.forge-wrap .unity-base-text-field__input {
    height: auto;
    min-height: 24px;
}

.forge-theme .unity-button {
    white-space: normal;
    -unity-text-align: middle-center;
}

.forge-theme .unity-base-popup-field__text,
.forge-theme .unity-object-field-display__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.forge-theme .forge-nav__label,
.forge-theme .forge-list-item__label,
.forge-theme .forge-sprite-field__name,
.forge-theme .forge-bar-row__label,
.forge-theme .forge-sidebar__tagline,
.forge-theme .forge-floor-room Label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.forge-theme .forge-details-title,
.forge-theme .forge-title,
.forge-theme .forge-section-title,
.forge-theme .forge-issue Label,
.forge-theme .forge-chip,
.forge-theme .forge-badge__text {
    white-space: normal;
}

.forge-floor-room > VisualElement {
    flex-shrink: 1;
    min-width: 0;
}

/* ---------- Structure : barre latérale ---------- */

.forge-studio {
    flex-direction: row;
}

.forge-sidebar {
    width: 224px;
    flex-shrink: 0;
    border-right-width: 1px;
    border-right-color: var(--forge-border);
    background-color: var(--forge-bg-sidebar);
}

.forge-sidebar__brand {
    flex-direction: row;
    align-items: center;
    padding: 18px 16px 14px 16px;
}

.forge-theme .forge-sidebar__mark {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    border-radius: 8px;
    background-color: var(--forge-accent);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.forge-sidebar__logo {
    font-size: 13px;
    -unity-font-style: bold;
}

.forge-theme .forge-sidebar__tagline {
    font-size: 10px;
    color: var(--forge-text-3);
}

.forge-theme .forge-sidebar__group {
    margin: 18px 18px 6px 18px;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--forge-text-3);
}

.forge-nav {
    flex-direction: row;
    align-items: center;
    min-height: 32px;
    margin: 1px 10px;
    padding: 0 10px 0 0;
    border-radius: 6px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.forge-nav:hover {
    background-color: var(--forge-hover);
}

.forge-nav--active,
.forge-nav--active:hover {
    background-color: var(--forge-surface);
}

.forge-nav__indicator {
    width: 3px;
    height: 16px;
    margin-right: 8px;
    border-radius: 2px;
    background-color: rgba(0, 0, 0, 0);
}

.forge-nav--active .forge-nav__indicator {
    background-color: var(--forge-accent);
}

.forge-nav__icon {
    width: 18px;
    height: 18px;
    margin-right: 10px;
}

.forge-theme .forge-nav__label {
    flex-grow: 1;
    color: var(--forge-text-2);
}

.forge-theme .forge-nav--active .forge-nav__label {
    color: var(--forge-text);
    -unity-font-style: bold;
}

.forge-theme .forge-nav__count {
    font-size: 11px;
    color: var(--forge-text-3);
}

.forge-nav__dot {
    display: none;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 3px;
    background-color: var(--forge-danger);
}

.forge-theme .forge-play-button {
    min-height: 34px;
    margin: 10px 14px 6px 14px;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--forge-accent);
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: bold;
}

.forge-theme .forge-play-button:hover {
    background-color: var(--forge-accent-hover);
}

.forge-theme .forge-sidebar__status {
    margin: 6px 14px 14px 14px;
    padding: 9px 10px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface);
    font-size: 11px;
    white-space: normal;
    color: var(--forge-text-2);
}

/* ---------- Structure : zone principale ---------- */

.forge-main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    background-color: var(--forge-bg);
}

.forge-main__header {
    flex-direction: row;
    align-items: center;
    padding: 16px 24px;
    border-bottom-width: 1px;
    border-bottom-color: var(--forge-border);
}

.forge-main__icon {
    width: 32px;
    height: 32px;
    margin-right: 14px;
}

.forge-theme .forge-breadcrumb {
    font-size: 10px;
    color: var(--forge-text-3);
    margin-bottom: 1px;
}

.forge-title {
    font-size: 18px;
    -unity-font-style: bold;
}

.forge-theme .forge-subtitle {
    color: var(--forge-text-2);
    white-space: normal;
}

.forge-theme .forge-help-toggle--active {
    border-color: var(--forge-accent);
    background-color: var(--forge-accent-soft);
    color: var(--forge-accent-text);
}

.forge-main__body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.forge-tab-content {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.forge-tab-content > * {
    flex-grow: 1;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-out;
}

.forge-tab-content > .forge-fade {
    opacity: 0;
    translate: 0 6px;
}

.forge-help-drawer {
    width: 330px;
    flex-shrink: 0;
    border-left-width: 1px;
    border-left-color: var(--forge-border);
    background-color: var(--forge-surface);
}

/* ---------- Cartes, sections, grilles ---------- */

.forge-section {
    margin: 0 0 12px 0;
    padding: 14px 16px;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface);
}

.forge-section-title {
    font-size: 13px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.forge-theme .forge-section-description {
    font-size: 11px;
    color: var(--forge-text-2);
    white-space: normal;
    margin: -4px 0 10px 0;
}

.forge-card {
    margin: 6px;
    padding: 16px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface);
    transition-property: border-color, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.forge-card--clickable:hover {
    border-color: var(--forge-accent);
    translate: 0 -2px;
}

.forge-card-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    margin: 0 -6px;
}

.forge-card-grid > .forge-card {
    flex-grow: 1;
    flex-basis: 220px;
}

.forge-card-grid > .forge-card--wide {
    flex-basis: 420px;
}

.forge-dashboard {
    padding: 20px 24px 32px 24px;
}

.forge-dashboard__heading {
    margin: 18px 0 6px 0;
    font-size: 14px;
    -unity-font-style: bold;
}

.forge-details {
    padding: 20px 24px;
}

.forge-details-pane {
    flex-grow: 1;
    flex-direction: column;
}

.forge-details-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 16px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface);
}

.forge-preview {
    width: 60px;
    height: 60px;
    margin-right: 16px;
    padding: 6px;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
}

.forge-details-title {
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.forge-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 2px 0 4px 0;
}

/* Badges : pastille teintée, point de couleur, texte neutre */

.forge-badge {
    flex-direction: row;
    align-items: center;
    padding: 2px 8px;
    margin: 4px 6px 4px 0;
    border-width: 1px;
    border-radius: 10px;
}

.forge-badge__dot {
    width: 6px;
    height: 6px;
    margin-right: 5px;
    border-radius: 3px;
}

.forge-badge__text {
    font-size: 10px;
    -unity-font-style: bold;
}

/* Statistiques */

.forge-stat {
    border-left-width: 3px;
}

.forge-stat--critical {
    border-left-color: var(--forge-danger);
}

.forge-stat--warning {
    border-left-color: var(--forge-warning);
}

.forge-stat--good {
    border-left-color: var(--forge-success);
}

.forge-stat__icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
}

.forge-theme .forge-stat__title {
    font-size: 11px;
    color: var(--forge-text-2);
    white-space: normal;
}

.forge-stat__value {
    font-size: 26px;
    -unity-font-style: bold;
    margin-top: 4px;
}

.forge-stat--compact .forge-stat__value {
    font-size: 18px;
}

.forge-card-grid > .forge-stat--compact {
    flex-basis: 140px;
    padding: 12px 14px;
}

.forge-progress-card {
    flex-direction: row;
    align-items: center;
}

.forge-progress-card__ring {
    margin-right: 14px;
    flex-shrink: 0;
}

.forge-theme .forge-progress-card__title {
    font-size: 11px;
    color: var(--forge-text-2);
}

.forge-progress-card__value {
    font-size: 22px;
    -unity-font-style: bold;
}

.forge-theme .forge-progress-card__caption {
    font-size: 10px;
    color: var(--forge-text-3);
}

.forge-progress-card__status {
    font-size: 10px;
    -unity-font-style: bold;
}

.forge-theme .forge-progress-card__status--error {
    color: var(--forge-danger);
}

.forge-theme .forge-progress-card__status--good {
    color: var(--forge-success);
}

/* ---------- Liste + fiche ---------- */

.forge-list-pane {
    min-width: 200px;
    padding: 14px 12px;
    border-right-width: 1px;
    border-right-color: var(--forge-border);
    background-color: var(--forge-bg);
}

.forge-list-item {
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
}

.forge-list-item__icon {
    width: 22px;
    height: 22px;
    margin-right: 8px;
}

.forge-list-item__strip {
    width: 8px;
    height: 8px;
    margin-right: 8px;
    border-radius: 4px;
}

.forge-list-item__label {
    flex-grow: 1;
    overflow: hidden;
}

.forge-list-item__warning {
    width: 7px;
    height: 7px;
    border-radius: 4px;
}

.forge-list-item__warning--error {
    background-color: var(--forge-danger);
}

.forge-list-item__warning--warning {
    background-color: var(--forge-warning);
}

.forge-array-row {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--forge-border);
}

.forge-table-row {
    flex-direction: row;
    align-items: center;
}

.forge-table-row > * {
    width: 90px;
    margin: 1px 4px 1px 0;
}

.forge-table-row > .forge-table-wide {
    flex-grow: 1;
    width: auto;
}

.forge-theme .forge-table-header {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--forge-text-3);
}

/* ---------- Problèmes et pied de validation ---------- */

.forge-issue {
    flex-direction: row;
    align-items: center;
    padding: 7px 10px;
    margin: 3px 0;
    border-width: 1px;
    border-left-width: 3px;
    border-radius: 8px;
    border-color: var(--forge-border);
    transition-property: translate;
    transition-duration: 0.12s;
}

.forge-issue:hover {
    translate: 2px 0;
}

.forge-issue Label {
    white-space: normal;
    flex-shrink: 1;
}

.forge-issue--error {
    border-left-color: var(--forge-danger);
    background-color: var(--forge-danger-soft);
}

.forge-issue--warning {
    border-left-color: var(--forge-warning);
    background-color: var(--forge-warning-soft);
}

.forge-issue--ok {
    border-left-color: var(--forge-success);
    background-color: var(--forge-success-soft);
}

.forge-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    padding: 12px 24px;
    border-top-width: 1px;
    border-top-color: var(--forge-border);
    background-color: var(--forge-surface);
}

.forge-footer__icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
}

.forge-theme .forge-footer__status {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    color: var(--forge-text-2);
}

.forge-theme .forge-footer__commit {
    min-width: 180px;
    min-height: 32px;
}

/* ---------- Sélecteurs ---------- */

.forge-picker__preview {
    width: 20px;
    height: 20px;
    margin-right: 6px;
}

.forge-sprite-field {
    margin: 3px 0;
}

.forge-sprite-field__label {
    min-width: 120px;
}

.forge-sprite-field__preview {
    width: 40px;
    height: 40px;
    margin-right: 10px;
    padding: 3px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
    transition-property: border-color;
    transition-duration: 0.12s;
}

.forge-sprite-field__preview:hover {
    border-color: var(--forge-accent);
}

.forge-theme .forge-sprite-field__name {
    flex-grow: 1;
    color: var(--forge-text-2);
}

.forge-gallery {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 10px;
}

.forge-gallery__cell {
    width: 86px;
    height: 86px;
    margin: 4px;
    padding: 6px;
    align-items: center;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface);
    transition-property: border-color, translate;
    transition-duration: 0.12s;
}

.forge-gallery__cell:hover {
    border-color: var(--forge-accent);
    translate: 0 -2px;
}

.forge-gallery__cell Image {
    width: 50px;
    height: 50px;
}

.forge-theme .forge-gallery__cell Label {
    font-size: 9px;
    overflow: hidden;
    color: var(--forge-text-2);
    -unity-text-align: middle-center;
}

/* ---------- Graphiques ---------- */

.forge-chart {
    flex-grow: 1;
    min-width: 200px;
}

.forge-theme .forge-chart__title {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    color: var(--forge-text-2);
    white-space: normal;
}

.forge-chart__plot {
    position: relative;
    min-height: 90px;
}

.forge-chart__labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.forge-theme .forge-chart__axis-label {
    position: absolute;
    font-size: 9px;
    color: var(--forge-text-3);
    padding: 0;
    margin: 0;
}

.forge-chart__axis-label--y {
    left: 0;
    -unity-text-align: middle-right;
}

.forge-chart__axis-label--x {
    width: 40px;
    -unity-text-align: upper-center;
}

.forge-chart__tooltip {
    display: none;
    position: absolute;
    padding: 6px 10px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--forge-border-strong);
    background-color: var(--forge-surface);
    font-size: 11px;
    white-space: nowrap;
}

.forge-chart__legend {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.forge-chart__legend-item {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.forge-theme .forge-chart__legend-item Label {
    font-size: 10px;
    color: var(--forge-text-2);
}

.forge-chart__swatch {
    width: 10px;
    height: 10px;
    margin-right: 6px;
    border-radius: 3px;
    flex-shrink: 0;
}

.forge-small-multiples {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 -6px;
}

.forge-small-multiples > .forge-chart {
    flex-basis: 220px;
    margin: 4px 6px;
    padding: 12px;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
}

.forge-chart-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.forge-chart-row > .forge-chart {
    flex-grow: 0;
    margin-right: 20px;
}

.forge-chart-row__grow {
    flex-grow: 1;
    flex-basis: 260px;
}

.forge-donut {
    flex-direction: row;
    align-items: center;
}

.forge-donut__ring {
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}

.forge-donut__center {
    align-items: center;
}

.forge-donut__value {
    font-size: 18px;
    -unity-font-style: bold;
}

.forge-theme .forge-donut__caption {
    font-size: 9px;
    color: var(--forge-text-3);
}

.forge-donut__legend {
    margin-left: 16px;
    min-width: 140px;
}

.forge-donut__legend-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-radius: 6px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.forge-donut__legend-row--hover {
    background-color: var(--forge-hover);
}

.forge-donut__legend-label {
    flex-grow: 1;
    font-size: 11px;
}

.forge-donut__legend-value {
    font-size: 11px;
    margin-left: 10px;
}

.forge-meter {
    margin: 6px 0 8px 0;
}

.forge-theme .forge-meter__title {
    flex-grow: 1;
    color: var(--forge-text-2);
}

.forge-meter__track {
    height: 8px;
    margin: 5px 0 2px 0;
    border-radius: 4px;
    background-color: var(--forge-surface-raised);
}

.forge-meter__band {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 4px;
    background-color: var(--forge-success-soft);
    border-width: 1px;
    border-color: var(--forge-success);
    transition-property: left, width;
    transition-duration: 0.3s;
}

.forge-meter__marker {
    position: absolute;
    top: -4px;
    width: 4px;
    height: 16px;
    margin-left: -2px;
    border-radius: 2px;
    transition-property: left, background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

.forge-theme .forge-meter__scale {
    font-size: 9px;
    color: var(--forge-text-3);
}

.forge-bar-row {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    padding: 0 6px;
    border-radius: 6px;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.forge-bar-row:hover {
    background-color: var(--forge-hover);
}

.forge-bar-row__icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
}

.forge-theme .forge-bar-row__label {
    width: 150px;
    overflow: hidden;
    white-space: nowrap;
    color: var(--forge-text-2);
}

.forge-bar-row__track {
    flex-grow: 1;
    height: 8px;
    border-radius: 4px;
    background-color: var(--forge-surface-raised);
}

.forge-bar-row__fill {
    height: 100%;
    border-radius: 4px;
    transition-property: width;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-cubic;
}

.forge-bar-row__value {
    width: 100px;
    -unity-text-align: middle-right;
    font-size: 11px;
}

/* ---------- Segmenté (Conversation / Arbre / Aperçu) ---------- */

.forge-view-switch {
    flex-direction: row;
    align-self: flex-start;
    margin: 4px 0 12px 0;
    padding: 3px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
}

.forge-theme .forge-view-switch__button {
    min-height: 26px;
    margin: 0;
    padding: 0 14px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-text-2);
}

.forge-theme .forge-view-switch__button:hover {
    border-color: rgba(0, 0, 0, 0);
    background-color: var(--forge-hover);
}

.forge-theme .forge-view-switch__button--active,
.forge-theme .forge-view-switch__button--active:hover {
    border-color: var(--forge-border-strong);
    background-color: var(--forge-surface);
    color: var(--forge-text);
    -unity-font-style: bold;
}

/* ---------- Biomes ---------- */

.forge-tile-preview {
    align-self: flex-start;
    margin: 6px 0;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--forge-border);
    overflow: hidden;
}

.forge-tile-preview__cell {
    width: 32px;
    height: 32px;
}

.forge-tile-preview__cell--missing {
    background-color: var(--forge-danger-soft);
}

/* ---------- Salles ---------- */

.forge-room-layout {
    flex-direction: row;
    align-items: flex-start;
}

.forge-room-properties {
    width: 340px;
    flex-shrink: 0;
    margin-right: 16px;
}

.forge-room-editor {
    flex-grow: 1;
    flex-direction: row;
    align-items: flex-start;
    min-height: 420px;
}

.forge-palette-scroll {
    width: 200px;
    max-height: 640px;
    flex-shrink: 0;
    margin-right: 12px;
}

.forge-theme .forge-palette__title {
    margin: 12px 0 4px 0;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--forge-text-3);
}

.forge-palette__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.forge-palette__brush {
    width: 58px;
    min-height: 62px;
    margin: 2px;
    padding: 4px 2px;
    align-items: center;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface);
    transition-property: border-color, translate;
    transition-duration: 0.12s;
}

.forge-palette__brush:hover {
    border-color: var(--forge-border-strong);
    translate: 0 -1px;
}

.forge-palette__brush--selected,
.forge-palette__brush--selected:hover {
    border-color: var(--forge-accent);
    background-color: var(--forge-accent-soft);
}

.forge-palette__icon {
    width: 32px;
    height: 32px;
}

.forge-theme .forge-palette__brush Label {
    font-size: 9px;
    overflow: hidden;
    color: var(--forge-text-2);
    -unity-text-align: middle-center;
    white-space: nowrap;
    max-width: 54px;
}

.forge-canvas-scroll {
    flex-grow: 1;
    max-height: 680px;
}

.forge-canvas__grid {
    border-width: 1px;
    border-radius: 6px;
    border-color: var(--forge-border-strong);
}

.forge-canvas__row {
    flex-direction: row;
}

.forge-canvas__cell {
    border-width: 0;
}

.forge-canvas__cell > Image {
    width: 100%;
    height: 100%;
}

.forge-canvas__cell--door {
    border-width: 2px;
    border-color: var(--forge-success);
}

.forge-canvas__cell--boss {
    border-width: 2px;
    border-color: var(--forge-danger);
}

.forge-canvas__cell--unreachable {
    -unity-background-image-tint-color: rgb(255, 130, 120);
    background-color: var(--forge-danger-soft);
}

.forge-theme .forge-canvas__status {
    margin-top: 6px;
    font-size: 11px;
    color: var(--forge-text-2);
    white-space: normal;
}

.forge-door-picker {
    align-items: center;
}

.forge-door-picker .forge-row {
    justify-content: space-between;
    width: 100%;
}

.forge-door-toggle {
    margin: 2px 8px;
}

.forge-door-toggle Label {
    min-width: 40px;
}

/* ---------- Étages ---------- */

.forge-floor-side {
    width: 240px;
    flex-shrink: 0;
    margin-right: 16px;
}

.forge-floor-side .forge-palette-scroll {
    width: auto;
    max-height: 420px;
    margin-right: 0;
}

.forge-floor-room {
    flex-direction: row;
    align-items: center;
    margin: 3px 0;
    padding: 6px;
    border-width: 1px;
    border-radius: 8px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface);
    transition-property: border-color, translate;
    transition-duration: 0.12s;
}

.forge-floor-room:hover {
    border-color: var(--forge-border-strong);
    translate: 2px 0;
}

.forge-floor-room--selected,
.forge-floor-room--selected:hover {
    border-color: var(--forge-accent);
    background-color: var(--forge-accent-soft);
}

.forge-floor-room--placed {
    opacity: 0.5;
}

.forge-floor-room__mini {
    width: 44px;
    height: 32px;
    margin-right: 10px;
    flex-shrink: 0;
}

.forge-theme .forge-floor-room__detail {
    font-size: 10px;
    color: var(--forge-text-3);
}

.forge-floor__board {
    position: relative;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--forge-border);
    background-color: var(--forge-canvas);
}

.forge-floor__labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.forge-floor__room-name {
    position: absolute;
    font-size: 10px;
    -unity-font-style: bold;
    overflow: hidden;
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.forge-theme .forge-floor__tag {
    position: absolute;
    padding: 0 6px;
    border-radius: 6px;
    font-size: 8px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

/* ---------- Dialogues ---------- */

.forge-dialogue-layout {
    flex-direction: row;
    align-items: stretch;
    min-height: 560px;
}

.forge-dialogue-layout__chat {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 320px;
    margin-right: 16px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface);
    overflow: hidden;
}

.forge-dialogue-layout__side {
    width: 380px;
    flex-shrink: 0;
    max-height: 700px;
}

.forge-chat {
    flex-grow: 1;
}

.forge-chat__thread {
    height: 470px;
    padding: 16px;
}

.forge-chat__block {
    margin-bottom: 12px;
}

.forge-chat__line {
    flex-direction: row;
    align-items: flex-end;
}

.forge-chat__line--player {
    justify-content: flex-end;
}

.forge-chat__line--narrator {
    justify-content: center;
}

.forge-chat__avatar {
    width: 36px;
    height: 36px;
    margin-right: 10px;
    border-radius: 18px;
    border-width: 2px;
    background-color: var(--forge-surface-raised);
    flex-shrink: 0;
}

.forge-chat__bubble {
    max-width: 78%;
    padding: 8px 12px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
    transition-property: border-color, translate;
    transition-duration: 0.12s;
}

.forge-chat__line--npc .forge-chat__bubble {
    border-bottom-left-radius: 4px;
}

.forge-chat__line--player .forge-chat__bubble {
    border-bottom-right-radius: 4px;
    border-color: var(--forge-accent);
    background-color: var(--forge-accent-soft);
}

.forge-chat__line--narrator .forge-chat__bubble {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--forge-border);
}

.forge-chat__bubble:hover {
    translate: 0 -1px;
    border-color: var(--forge-border-strong);
}

.forge-chat__bubble--selected,
.forge-chat__bubble--selected:hover {
    border-width: 2px;
    border-color: var(--forge-accent);
}

.forge-chat__meta {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.forge-theme .forge-chat__speaker {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--forge-text-2);
    margin-right: 6px;
}

.forge-theme .forge-chat__id {
    font-size: 9px;
    color: var(--forge-text-3);
    margin-right: 6px;
}

.forge-chat__text {
    white-space: normal;
    font-size: 12px;
}

.forge-chat__line--narrator .forge-chat__text {
    -unity-font-style: italic;
    -unity-text-align: middle-center;
}

.forge-theme .forge-chat__text--empty {
    color: var(--forge-text-3);
    -unity-font-style: italic;
}

.forge-chat__replies {
    align-items: flex-end;
    margin: 6px 0 0 46px;
}

.forge-chat__reply {
    max-width: 75%;
    margin: 2px 0;
    padding: 6px 12px;
    border-width: 1px;
    border-radius: 14px;
    border-bottom-right-radius: 4px;
    border-color: var(--forge-accent);
    background-color: var(--forge-surface);
    transition-property: background-color, translate;
    transition-duration: 0.12s;
}

.forge-chat__reply:hover {
    background-color: var(--forge-accent-soft);
    translate: -2px 0;
}

.forge-chat__reply-text {
    white-space: normal;
}

.forge-chat__chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.forge-theme .forge-chat__system {
    align-self: center;
    margin: 6px 0;
    padding: 2px 10px;
    border-radius: 10px;
    font-size: 10px;
    color: var(--forge-text-3);
    background-color: var(--forge-surface-raised);
}

.forge-theme .forge-chat__jump {
    align-self: flex-start;
    margin: 3px 0 0 46px;
    font-size: 10px;
    color: var(--forge-accent-text);
}

.forge-chip {
    padding: 1px 7px;
    margin: 1px 4px 1px 0;
    border-radius: 8px;
    font-size: 9px;
    -unity-font-style: bold;
}

.forge-theme .forge-chip--condition {
    background-color: var(--forge-accent-soft);
    color: var(--forge-accent-text);
}

.forge-theme .forge-chip--effect {
    background-color: var(--forge-warning-soft);
    color: var(--forge-warning);
}

.forge-theme .forge-chip--target {
    background-color: var(--forge-surface-raised);
    color: var(--forge-text-2);
}

.forge-theme .forge-chip--start {
    background-color: var(--forge-success-soft);
    color: var(--forge-success);
}

.forge-composer {
    padding: 12px;
    border-top-width: 1px;
    border-top-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
}

.forge-composer__speakers {
    flex-direction: row;
    margin-bottom: 6px;
}

.forge-theme .forge-composer__speaker {
    min-height: 24px;
    border-radius: 12px;
    padding: 0 12px;
}

.forge-theme .forge-composer__speaker--active {
    border-color: var(--forge-accent);
    background-color: var(--forge-accent-soft);
    color: var(--forge-accent-text);
    -unity-font-style: bold;
}

.forge-composer__input {
    flex-grow: 1;
}

.forge-theme .forge-composer__input .unity-base-text-field__input {
    min-height: 30px;
    border-radius: 15px;
    padding-left: 14px;
}

.forge-dialogue-inspector {
    padding: 14px 16px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface);
}

.forge-dialogue-inspector__text TextInput {
    min-height: 72px;
}

.forge-theme .forge-dialogue-inspector__counter {
    font-size: 10px;
    color: var(--forge-text-3);
    -unity-text-align: middle-right;
}

.forge-theme .forge-dialogue-inspector__counter--over {
    color: var(--forge-danger);
    -unity-font-style: bold;
}

.forge-dialogue-choice {
    flex-grow: 1;
    padding: 6px 0;
}

.forge-dialogue-choice__rules {
    margin-left: 4px;
}

.forge-rule-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.forge-rule-row__type {
    width: 160px;
    flex-shrink: 0;
}

.forge-rule-row__value {
    flex-direction: row;
    flex-grow: 1;
}

.forge-rule-row__value > * {
    flex-grow: 1;
}

.forge-dialogue-graph__scroll {
    height: 560px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border);
    background-color: var(--forge-canvas);
}

.forge-dialogue-graph__canvas {
    position: relative;
}

.forge-dialogue-graph__edges {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.forge-dialogue-graph__box {
    position: absolute;
    flex-direction: row;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--forge-border-strong);
    background-color: var(--forge-surface);
    overflow: hidden;
    transition-property: border-color, translate;
    transition-duration: 0.12s;
}

.forge-dialogue-graph__box:hover {
    border-color: var(--forge-accent);
    translate: 0 -2px;
}

.forge-dialogue-graph__box--selected {
    border-width: 2px;
    border-color: var(--forge-accent);
}

.forge-dialogue-graph__box--orphan {
    border-color: var(--forge-warning);
}

.forge-dialogue-graph__box Label {
    font-size: 10px;
}

.forge-dialogue-graph__stripe {
    width: 4px;
    margin-right: 8px;
}

.forge-theme .forge-dialogue-graph__text {
    white-space: normal;
    color: var(--forge-text-2);
}

.forge-theme .forge-dialogue-graph__edge-label {
    position: absolute;
    width: 80px;
    font-size: 9px;
    -unity-text-align: middle-center;
    padding: 1px 4px;
    border-radius: 6px;
    background-color: var(--forge-surface);
    color: var(--forge-text-2);
    overflow: hidden;
    white-space: nowrap;
}

/* Aperçu en jeu : volontairement « jeu » (sombre), quel que soit le thème */

.forge-preview-game {
    flex-direction: row;
    align-items: flex-start;
}

.forge-preview-game__left {
    flex-grow: 1;
    margin-right: 16px;
}

.forge-preview-game__right {
    width: 290px;
    flex-shrink: 0;
    padding: 14px 16px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface);
}

.forge-preview-game__screen {
    min-height: 420px;
    justify-content: space-between;
    padding: 14px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border-strong);
    background-color: rgb(28, 25, 33);
    background-size: 64px 64px;
    background-repeat: repeat repeat;
    -unity-background-image-tint-color: rgb(110, 110, 120);
}

.forge-theme .forge-preview-game__hud {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 8px;
    font-size: 11px;
    color: rgb(235, 235, 235);
    background-color: rgba(0, 0, 0, 0.6);
}

.forge-preview-game__box {
    flex-direction: row;
    min-height: 140px;
    padding: 12px;
    border-width: 1px;
    border-radius: 10px;
    border-color: rgb(200, 180, 140);
    background-color: rgba(14, 12, 18, 0.94);
}

.forge-preview-game__portrait {
    width: 96px;
    height: 96px;
    margin-right: 14px;
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(200, 180, 140);
    background-color: rgba(255, 255, 255, 0.06);
    flex-shrink: 0;
}

.forge-preview-game__content {
    flex-grow: 1;
    flex-shrink: 1;
}

.forge-theme .forge-preview-game__name {
    align-self: flex-start;
    padding: 1px 10px;
    margin-bottom: 6px;
    border-radius: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.forge-theme .forge-preview-game__text {
    white-space: normal;
    font-size: 14px;
    color: rgb(240, 236, 228);
    min-height: 44px;
}

.forge-theme .forge-preview-game__text--narration {
    -unity-font-style: italic;
    color: rgb(200, 195, 185);
}

.forge-preview-game__choices {
    margin-top: 8px;
}

.forge-theme .forge-preview-game__choice {
    -unity-text-align: middle-left;
    white-space: normal;
    padding-top: 6px;
    padding-bottom: 6px;
    margin: 2px 0;
    padding: 4px 10px;
    border-radius: 6px;
    border-color: rgba(200, 180, 140, 0.45);
    background-color: rgba(255, 255, 255, 0.04);
    color: rgb(240, 236, 228);
    transition-property: background-color, translate;
    transition-duration: 0.1s;
}

.forge-theme .forge-preview-game__choice:hover {
    border-color: rgb(200, 180, 140);
    background-color: rgba(200, 180, 140, 0.2);
    translate: 4px 0;
}

.forge-theme .forge-preview-game__prompt {
    margin-top: 6px;
    font-size: 10px;
    color: rgb(200, 180, 140);
    -unity-text-align: middle-right;
}

.forge-preview-game__journal {
    height: 200px;
    margin-top: 6px;
}

.forge-journal {
    white-space: normal;
    font-size: 10px;
    margin: 2px 0;
    padding: 3px 8px;
    border-left-width: 2px;
    border-radius: 4px;
}

.forge-journal--line {
    border-left-color: var(--forge-border-strong);
}

.forge-journal--player {
    border-left-color: var(--forge-accent);
}

.forge-journal--effect {
    border-left-color: var(--forge-warning);
    background-color: var(--forge-warning-soft);
}

.forge-theme .forge-journal--system {
    color: var(--forge-text-3);
    -unity-font-style: italic;
    border-left-color: rgba(0, 0, 0, 0);
}

.forge-journal--error {
    border-left-color: var(--forge-danger);
    background-color: var(--forge-danger-soft);
}

/* ---------- Aide ---------- */

.forge-help {
    padding: 20px 24px;
}

.forge-help-h1 {
    font-size: 16px;
    -unity-font-style: bold;
    margin: 4px 0 8px 0;
}

.forge-theme .forge-help-h2 {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin: 16px 0 4px 0;
    color: var(--forge-accent-text);
}

.forge-theme .forge-help-text,
.forge-theme .forge-help-bullet {
    white-space: normal;
    margin: 2px 0;
    color: var(--forge-text-2);
}

.forge-help-bullet {
    margin-left: 10px;
}

/* ---------- Progression ---------- */

.forge-stat-card {
    padding: 8px 10px;
    margin-bottom: 8px;
    border-width: 1px;
    border-left-width: 4px;
    border-radius: 8px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
}

.forge-stat-card__row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin: 2px 0;
}

.forge-stat-card__row > .unity-base-field {
    flex-grow: 1;
    flex-basis: 180px;
    margin-right: 8px;
}

.forge-stat-card__row > .forge-stat-card__color {
    flex-grow: 0;
    flex-basis: 44px;
    width: 44px;
}

.forge-stat-card__row > .forge-stat-card__name {
    flex-basis: 140px;
    -unity-font-style: bold;
}

.forge-stat-card__button {
    flex-shrink: 0;
}

.forge-stat-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}

.forge-stat-tabs__list {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
}

.forge-theme .forge-stat-tab {
    margin: 0 6px 4px 0;
    padding: 3px 12px;
    border-radius: 12px;
    border-width: 0 0 2px 0;
    background-color: var(--forge-surface-raised);
    color: var(--forge-text-2);
}

.forge-theme .forge-stat-tab--selected {
    -unity-font-style: bold;
    color: var(--forge-text);
}

.forge-curve-editor .forge-chart__plot {
    border-radius: 8px;
    background-color: var(--forge-surface);
}

.forge-stat-card__sub {
    margin-left: 52px;
}

.forge-stat-card__row > .forge-stat-card__rank {
    flex-basis: 110px;
    flex-grow: 0;
}

.forge-stat-card__rank > .unity-label {
    min-width: 50px;
}

.forge-reward-row {
    padding: 2px 0;
    border-bottom-width: 1px;
    border-color: var(--forge-border);
}

.forge-stat-card__row > .forge-reward-row__level {
    flex-basis: 120px;
    flex-grow: 0;
}

.forge-reward-row__level > .unity-label {
    min-width: 50px;
}

.forge-stat-card__rank-title {
    min-width: 56px;
    -unity-font-style: bold;
}

/* ==========================================================================
   Verre d'encre : polices, verre, formes souples.
   Placé en fin de fichier : ces règles complètent et remplacent les précédentes.
   ========================================================================== */

/* ---------- Polices (licence OFL, dossier Fonts) ---------- */

.forge-theme {
    -unity-font-definition: url("Fonts/GothicA1-Regular.ttf");
}

.forge-theme .forge-title,
.forge-theme .forge-section-title,
.forge-theme .forge-details-title,
.forge-theme .forge-sidebar__logo,
.forge-theme .forge-tile__title,
.forge-theme .forge-acc__name,
.forge-theme .forge-srow__name,
.forge-theme .forge-dashboard__heading {
    -unity-font-definition: url("Fonts/GothicA1-Bold.ttf");
    -unity-font-style: normal;
}

/* Grands nombres : niveau, valeur d'une stat, totaux. */
.forge-theme .forge-big,
.forge-theme .forge-stat__value,
.forge-theme .forge-fact__value,
.forge-theme .forge-lvl__number,
.forge-theme .forge-tl__number,
.forge-theme .forge-sim-stat__value {
    -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf");
    -unity-font-style: normal;
}

/* Messages système, valeurs alignées, noms de fichiers. */
.forge-theme .forge-mono,
.forge-theme .forge-key,
.forge-theme .forge-footer__status,
.forge-theme .forge-chart__axis-label {
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular.ttf");
    -unity-font-style: normal;
}

/* ---------- Fenêtre : ciel derrière, panneaux en verre devant ---------- */

.forge-theme.forge-studio {
    padding: 12px;
    background-color: #0c0c12;
    -unity-background-scale-mode: scale-and-crop;
}

.forge-theme .forge-main {
    background-color: rgba(0, 0, 0, 0);
}

/* Verre : fond translucide, liseré clair en haut et à gauche, coins arrondis. Le reflet du curseur y est découpé. */
.forge-theme .forge-glass,
.forge-theme .forge-sidebar,
.forge-theme .forge-main__header,
.forge-theme .forge-help-drawer,
.forge-theme .forge-list-pane,
.forge-theme .forge-details-header,
.forge-theme .forge-section,
.forge-theme .forge-card,
.forge-theme .forge-footer,
.forge-theme .forge-seg {
    overflow: hidden;
    border-width: 1px;
    border-color: var(--forge-border);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
}

.forge-theme .forge-sidebar {
    margin-right: 12px;
    border-radius: 22px;
    border-right-color: var(--forge-border);
    background-color: var(--forge-bg-sidebar);
}

.forge-theme .forge-main__header {
    margin-bottom: 12px;
    padding: 10px 12px 10px 18px;
    border-radius: 22px;
    border-bottom-color: var(--forge-border);
    background-color: var(--forge-bg-sidebar);
}

.forge-theme .forge-help-drawer {
    margin-left: 12px;
    border-radius: 22px;
    border-left-color: var(--forge-rim);
    background-color: var(--forge-bg-sidebar);
}

.forge-theme .forge-list-pane {
    margin-right: 6px;
    border-radius: 22px;
    border-right-color: var(--forge-border);
    background-color: var(--forge-bg-sidebar);
}

.forge-theme .forge-details {
    padding: 0 4px 0 10px;
}

.forge-theme .forge-details-header {
    border-radius: 22px;
    background-color: var(--forge-surface);
}

.forge-theme .forge-section,
.forge-theme .forge-card {
    border-radius: 18px;
    background-color: var(--forge-surface);
}

.forge-theme .forge-card--clickable:hover {
    border-color: var(--forge-accent);
}

/* Barre de validation : capsule de verre flottante, centrée. */
.forge-theme .forge-footer {
    align-self: center;
    margin: 10px 0 2px 0;
    padding: 6px 6px 6px 16px;
    border-radius: 16px;
    border-top-color: var(--forge-rim);
    background-color: var(--forge-bg-sidebar);
}

.forge-glass-light {
    position: absolute;
    width: 360px;
    height: 360px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

/* ---------- Navigation ---------- */

.forge-theme .forge-sidebar__mark {
    border-radius: 10px;
    background-color: var(--forge-accent-tint);
}

.forge-theme .forge-nav {
    border-radius: 12px;
}

.forge-theme .forge-nav--active,
.forge-theme .forge-nav--active:hover {
    background-color: var(--forge-accent-soft);
    border-top-width: 1px;
    border-left-width: 1px;
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
}

.forge-theme .forge-play-button {
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.32);
    background-color: var(--forge-accent-tint);
}

.forge-theme .forge-play-button:hover {
    background-color: rgba(138, 168, 224, 0.64);
}

.forge-theme .forge-sidebar__status {
    border-radius: 14px;
    background-color: var(--forge-surface-raised);
}

.forge-theme .unity-collection-view__item {
    border-radius: 12px;
}

.forge-theme .unity-collection-view__item--selected,
.forge-theme .unity-collection-view__item--selected:hover {
    background-color: var(--forge-accent-soft);
}

/* ---------- Contrôles ---------- */

.forge-theme .unity-button {
    min-height: 28px;
    padding: 0 14px;
    border-radius: 10px;
    border-color: var(--forge-border-strong);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: var(--forge-surface-raised);
}

.forge-theme .unity-button:hover {
    background-color: rgba(232, 238, 250, 0.11);
}

.forge-theme .forge-button--primary {
    border-color: rgba(255, 255, 255, 0.32);
    background-color: var(--forge-accent-tint);
    color: rgb(255, 255, 255);
}

.forge-theme .forge-button--primary:hover {
    border-color: rgba(255, 255, 255, 0.45);
    background-color: rgba(138, 168, 224, 0.64);
}

.forge-theme .forge-button--danger {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-danger);
}

.forge-theme .forge-button--danger:hover {
    background-color: var(--forge-danger-soft);
}

.forge-theme .forge-button--quiet {
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-text-2);
}

.forge-theme .forge-button--quiet:hover {
    background-color: var(--forge-accent-soft);
    color: var(--forge-text);
}

.forge-theme .unity-base-text-field__input,
.forge-theme .unity-base-popup-field__input,
.forge-theme .unity-object-field__input {
    min-height: 26px;
    padding: 2px 10px;
    border-radius: 10px;
}

.forge-theme .unity-base-text-field__input:focus,
.forge-theme .unity-base-field:focus > .unity-base-text-field__input {
    border-color: var(--forge-accent);
    background-color: rgba(10, 10, 15, 0.8);
}

.forge-theme .forge-chart__tooltip {
    border-radius: 14px;
    border-color: var(--forge-border-strong);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: rgba(23, 23, 30, 0.94);
}

.forge-theme .forge-issue {
    border-radius: 12px;
}

.forge-theme .forge-badge {
    border-radius: 8px;
}

/* ---------- Progression : catégories (contrôle segmenté) ---------- */

.forge-seg {
    flex-direction: row;
    align-self: flex-start;
    flex-wrap: wrap;
    margin-bottom: 12px;
    padding: 4px;
    border-radius: 14px;
    background-color: var(--forge-bg-sidebar);
}

.forge-seg__drop {
    position: absolute;
    top: 4px;
    bottom: 4px;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--forge-border);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: var(--forge-accent-soft);
    transition-property: left, width, top;
    transition-duration: 0.32s;
    transition-timing-function: ease-out-back;
}

.forge-theme .forge-seg__item {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    margin: 0;
    padding: 0 14px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-text-2);
}

.forge-theme .forge-seg__item:hover {
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-text);
}

.forge-theme .forge-seg__item--selected {
    color: var(--forge-text);
}

.forge-theme .forge-seg__count {
    margin-left: 6px;
    font-size: 10px;
    color: var(--forge-text-3);
}

/* ---------- Progression : tuiles de l'aperçu ---------- */

.forge-tiles {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 -6px;
}

.forge-theme .forge-tile {
    flex-grow: 1;
    flex-basis: 300px;
    margin: 0 6px 12px 6px;
}

.forge-theme .forge-tile--wide {
    flex-basis: 620px;
}

.forge-theme .forge-tile--full {
    flex-basis: 100%;
}

.forge-tile__header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.forge-tile__title {
    font-size: 13px;
}

.forge-theme .forge-big {
    font-size: 40px;
    color: var(--forge-text);
    -unity-text-align: middle-right;
}

.forge-sparks {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 -4px;
}

.forge-spark-card {
    flex-grow: 1;
    flex-basis: 150px;
    margin: 4px;
    padding: 8px 10px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--forge-border);
    background-color: rgba(232, 238, 250, 0.03);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.forge-spark-card:hover {
    background-color: rgba(232, 238, 250, 0.07);
}

.forge-spark {
    height: 30px;
    margin: 4px 0;
}

.forge-mini-row {
    flex-direction: row;
    align-items: center;
    min-height: 30px;
    padding: 0 10px;
    border-radius: 10px;
}

.forge-mini-row:hover {
    background-color: var(--forge-hover);
}

.forge-theme .forge-mini-row__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.forge-theme .forge-mini-row__value {
    flex-grow: 0;
    flex-shrink: 1;
    margin-left: 10px;
    -unity-text-align: middle-right;
    color: var(--forge-text-2);
}

.forge-theme .forge-key {
    flex-grow: 0;
    padding: 1px 9px;
    border-radius: 6px;
    background-color: var(--forge-accent-soft);
    color: var(--forge-accent-text);
    font-size: 10px;
}

.forge-dot {
    width: 8px;
    height: 8px;
    margin-right: 10px;
    flex-shrink: 0;
    border-radius: 4px;
}

/* ---------- Progression : stats et courbes ---------- */

.forge-split {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin: 0 -6px;
}

.forge-theme .forge-stat-list {
    width: 250px;
    flex-grow: 1;
    flex-shrink: 0;
    max-width: 320px;
    margin: 0 6px 12px 6px;
}

.forge-split__main {
    flex-grow: 100;
    flex-basis: 480px;
    min-width: 0;
    margin: 0 6px;
}

.forge-srow {
    flex-direction: row;
    align-items: center;
    padding: 7px 10px;
    margin-bottom: 3px;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.forge-srow:hover {
    background-color: var(--forge-hover);
}

.forge-srow--selected,
.forge-srow--selected:hover {
    border-color: var(--forge-border);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: var(--forge-accent-soft);
}

.forge-srow__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.forge-srow__name {
    overflow: hidden;
    text-overflow: ellipsis;
}

.forge-theme .forge-srow__meta {
    font-size: 10px;
    color: var(--forge-text-3);
}

.forge-srow .forge-spark {
    width: 60px;
    height: 24px;
    margin: 0 0 0 8px;
    flex-shrink: 0;
}

.forge-curve-head {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.forge-curve-head .forge-section-title {
    margin-bottom: 0;
    font-size: 15px;
}

.forge-theme .forge-curve-head__range {
    flex-grow: 1;
    margin-left: 12px;
    font-size: 11px;
    color: var(--forge-text-3);
}

.forge-theme .forge-curve-editor .forge-chart__plot {
    border-radius: 14px;
    background-color: rgba(10, 10, 15, 0.5);
}

.forge-theme .forge-fold > .unity-foldout__toggle .unity-foldout__text {
    -unity-font-definition: url("Fonts/GothicA1-Bold.ttf");
    -unity-font-style: normal;
    font-size: 13px;
}

/* ---------- Progression : lignes dépliables ---------- */

.forge-acc {
    margin-bottom: 6px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--forge-border);
    background-color: rgba(232, 238, 250, 0.03);
}

.forge-acc--open {
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: rgba(232, 238, 250, 0.05);
}

.forge-acc__head {
    flex-direction: row;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 14px;
}

.forge-acc__head:hover {
    background-color: var(--forge-hover);
}

.forge-acc__name {
    min-width: 110px;
    margin-right: 12px;
}

.forge-theme .forge-acc__meta {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--forge-text-3);
}

.forge-theme .forge-acc__chevron {
    margin-left: 10px;
    color: var(--forge-text-3);
}

.forge-acc__body {
    padding: 4px 14px 12px 14px;
}

.forge-theme .forge-acc__body .forge-stat-card {
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.forge-theme .forge-stat-card {
    border-left-width: 1px;
    border-radius: 14px;
    background-color: rgba(232, 238, 250, 0.03);
}

/* ---------- Progression : frise des niveaux et pastilles ---------- */

.forge-timeline {
    flex-direction: row;
    padding-bottom: 4px;
}

.forge-tl {
    width: 34px;
    flex-shrink: 0;
    align-items: center;
    margin-right: 4px;
    padding: 6px 0 8px 0;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(232, 238, 250, 0.03);
}

.forge-tl:hover {
    background-color: rgba(232, 238, 250, 0.08);
}

.forge-tl--selected,
.forge-tl--selected:hover {
    border-color: var(--forge-border);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: var(--forge-accent-soft);
}

.forge-theme .forge-tl__number {
    font-size: 15px;
    color: var(--forge-text-2);
}

.forge-theme .forge-tl--selected .forge-tl__number {
    color: var(--forge-text);
}

.forge-tl__dots {
    min-height: 18px;
    margin-top: 4px;
    align-items: center;
}

.forge-pill {
    width: 8px;
    height: 8px;
    margin: 1px 2px;
    border-radius: 4px;
}

.forge-pill--bad {
    width: 10px;
    height: 10px;
    border-width: 1.5px;
    border-radius: 5px;
    border-color: var(--forge-danger);
}

.forge-pill--points { background-color: var(--forge-success); }
.forge-pill--skill { background-color: var(--forge-accent); }
.forge-pill--mechanic { background-color: var(--forge-lavender); }
.forge-pill--note { background-color: var(--forge-text-2); }

.forge-pills {
    flex-direction: row;
    align-items: center;
    min-width: 40px;
    margin-right: 12px;
}

.forge-pills__sep {
    width: 1px;
    height: 12px;
    margin: 0 4px;
    background-color: var(--forge-border-strong);
}

.forge-legend {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 8px;
}

.forge-legend > VisualElement {
    flex-direction: row;
    align-items: center;
    margin-right: 14px;
}

.forge-theme .forge-legend Label {
    margin-left: 4px;
    font-size: 11px;
    color: var(--forge-text-3);
}

/* ---------- Progression : simulation ---------- */

.forge-sim-top {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.forge-sim-level {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
}

.forge-theme .forge-sim-level .forge-big {
    min-width: 64px;
    -unity-text-align: middle-center;
}

.forge-sim-top > .unity-slider-int {
    flex-grow: 1;
    flex-basis: 220px;
    margin-right: 16px;
}

.forge-bars {
    flex-direction: row;
    align-items: flex-end;
    height: 96px;
    margin: 6px 0 12px 0;
}

.forge-bar {
    flex-grow: 1;
    flex-basis: 0;
    height: 100%;
    justify-content: flex-end;
    margin-right: 3px;
}

.forge-bar__fill {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    background-color: rgba(138, 168, 224, 0.28);
}

.forge-bar:hover .forge-bar__fill {
    background-color: rgba(138, 168, 224, 0.5);
}

.forge-bar--selected .forge-bar__fill,
.forge-bar--selected:hover .forge-bar__fill {
    background-color: var(--forge-accent);
}

.forge-theme .forge-bar__label {
    font-size: 9px;
    -unity-text-align: middle-center;
    color: var(--forge-text-3);
}

.forge-sim-blocks {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 -6px;
}

.forge-sim-block {
    flex-grow: 1;
    flex-basis: 260px;
    margin: 0 6px 12px 6px;
    padding: 12px 14px;
    border-width: 1px;
    border-radius: 16px;
    border-color: var(--forge-border);
    background-color: rgba(232, 238, 250, 0.035);
}

.forge-sim-stat {
    margin-bottom: 8px;
}

.forge-sim-stat__row {
    flex-direction: row;
    align-items: center;
}

.forge-sim-stat__row > Label {
    flex-grow: 1;
}

.forge-theme .forge-sim-stat__value {
    flex-grow: 0;
    font-size: 19px;
    color: var(--forge-text);
}

.forge-theme .forge-delta {
    flex-grow: 0;
    min-width: 54px;
    margin-left: 10px;
    font-size: 11px;
    -unity-text-align: middle-right;
    color: var(--forge-text-3);
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular.ttf");
}

.forge-theme .forge-delta--up { color: var(--forge-success); }
.forge-theme .forge-delta--down { color: var(--forge-danger); }

.forge-mini-meter {
    height: 4px;
    margin-top: 4px;
    border-radius: 2px;
    background-color: rgba(232, 238, 250, 0.08);
}

.forge-mini-meter__fill {
    height: 100%;
    border-radius: 2px;
}

.forge-sim-action {
    flex-direction: row;
    margin-bottom: 8px;
}

.forge-sim-action--locked {
    opacity: 0.45;
}

.forge-sim-action .forge-dot {
    margin-top: 5px;
}

.forge-facts {
    flex-direction: row;
    flex-wrap: wrap;
}

.forge-fact {
    flex-basis: 45%;
    flex-grow: 1;
    margin: 0 8px 10px 0;
}

.forge-theme .forge-fact__value {
    font-size: 26px;
    color: var(--forge-text);
}

.forge-theme .forge-fact__label {
    font-size: 10px;
    white-space: normal;
    color: var(--forge-text-3);
}

.forge-theme .forge-lvl__number {
    width: 34px;
    font-size: 19px;
    -unity-text-align: middle-center;
    color: var(--forge-text-2);
}

.forge-theme .forge-acc--current {
    border-color: rgba(138, 168, 224, 0.45);
}

.forge-theme .forge-acc--current .forge-lvl__number {
    color: var(--forge-accent);
}

.forge-lvl-grid {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 -6px 8px -6px;
}

.forge-lvl-field {
    flex-basis: 170px;
    flex-grow: 1;
    margin: 0 6px 8px 6px;
}

.forge-lvl-field__row {
    flex-direction: row;
    align-items: center;
}

.forge-lvl-field__row > .unity-base-field {
    flex-grow: 1;
    margin: 0;
}

.forge-lvl-rewards {
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--forge-border);
}

/* ---------- Recherche et cases à cocher ---------- */

.forge-theme .unity-toolbar-search-field {
    min-height: 30px;
    margin: 6px 0 8px 0;
    padding: 0 4px 0 10px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: var(--forge-input);
    align-items: center;
}

.forge-theme .unity-toolbar-search-field .unity-base-text-field__input,
.forge-theme .unity-toolbar-search-field .unity-text-field__input {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    min-height: 26px;
}

.forge-theme .unity-search-field-base__search-button {
    width: 14px;
    height: 14px;
    opacity: 0.55;
}

.forge-theme .unity-search-field-base__cancel-button {
    width: 14px;
    height: 14px;
    margin-right: 4px;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.55;
}

.forge-theme .unity-toggle__checkmark {
    width: 16px;
    height: 16px;
    border-width: 1px;
    border-radius: 5px;
    border-color: var(--forge-border-strong);
    background-color: var(--forge-input);
}

.forge-theme .unity-toggle:checked .unity-toggle__checkmark {
    border-color: var(--forge-success);
    background-color: var(--forge-success-soft);
    -unity-background-image-tint-color: var(--forge-success);
}

.forge-theme .forge-sidebar__status {
    white-space: normal;
}

/* La flèche des dépliants utilise aussi « unity-toggle__checkmark » : elle garde son apparence de flèche. */
.forge-theme .unity-foldout__toggle .unity-toggle__checkmark,
.forge-theme .unity-foldout__toggle:checked .unity-toggle__checkmark {
    width: 12px;
    height: 12px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: var(--forge-text-2);
}

.forge-theme .unity-search-field-base__search-button {
    margin-left: 2px;
    margin-right: 4px;
}

.forge-theme .forge-srow__meta {
    margin-top: 2px;
}

.forge-theme .forge-section-description {
    margin-bottom: 12px;
}

.forge-theme .unity-toolbar-search-field .unity-search-field-base__search-button {
    margin-left: 6px;
    margin-right: 6px;
}

.forge-theme .unity-toolbar-search-field .unity-search-field-base__cancel-button {
    border-width: 0;
}

.forge-theme .unity-toolbar-search-field .unity-search-field-base__search-button,
.forge-theme .unity-toolbar-search-field .unity-search-field-base__search-button:hover {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

/* ---------- Libellés des champs : centrés sur la hauteur du champ ---------- */

.forge-theme .unity-base-field {
    align-items: center;
}

.forge-theme .unity-base-field__label {
    -unity-text-align: middle-left;
}

/* ---------- Curseurs : piste fine, poignée ronde ---------- */

.forge-theme .unity-base-slider__input {
    justify-content: center;
}

/* Piste, remplissage et poignée centrés sur la hauteur du champ, donc alignés avec le libellé. */
.forge-theme .unity-base-slider--horizontal .unity-base-slider__tracker {
    top: 50%;
    height: 4px;
    margin-top: -2px;
    border-width: 0;
    border-radius: 2px;
    background-color: rgba(232, 238, 250, 0.12);
}

.forge-theme .unity-base-slider--horizontal .unity-base-slider__dragger {
    width: 16px;
    height: 16px;
    margin-top: -3px;
    border-width: 1px;
    border-radius: 8px;
    border-color: rgba(255, 255, 255, 0.55);
    background-color: #e8eefa;
}

.forge-theme .unity-base-slider__dragger-border {
    display: none;
}

.forge-theme .unity-base-slider__fill {
    top: 50%;
    height: 4px;
    margin-top: -2px;
    border-radius: 2px;
    background-color: var(--forge-accent);
}

.forge-theme .unity-base-slider__text-field {
    align-self: center;
    width: 52px;
    margin: 0 0 0 10px;
}

/* ---------- Sélecteur de couleur : pastille arrondie dans un cadre de verre ---------- */

.forge-theme .unity-color-field__input {
    min-height: 26px;
    padding: 4px;
    border-width: 1px;
    border-radius: 10px;
    border-color: var(--forge-border-strong);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: var(--forge-input);
}

.forge-theme .unity-color-field__color {
    border-radius: 6px;
}

.forge-theme .unity-color-field__alpha {
    display: none;
}

.forge-theme .unity-color-field__eyedropper {
    width: 16px;
    height: 16px;
    margin-left: 6px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    opacity: 0.55;
}

.forge-theme .unity-color-field__eyedropper:hover {
    opacity: 1;
}

/* ---------- Listes déroulantes : champ et menu ---------- */

.forge-theme .unity-base-popup-field__input,
.forge-theme .unity-enum-field__input {
    padding: 2px 10px;
    border-radius: 10px;
}

.forge-theme .unity-base-popup-field__arrow,
.forge-theme .unity-enum-field__arrow {
    width: 10px;
    height: 10px;
    -unity-background-image-tint-color: var(--forge-text-2);
}

.forge-menu {
    -unity-font-definition: url("Fonts/GothicA1-Regular.ttf");
}

.forge-menu .unity-base-dropdown__container-outer {
    margin-top: 4px;
    padding: 4px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border-strong);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: rgba(23, 23, 30, 0.97);
}

.forge-menu .unity-base-dropdown__container-inner {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.forge-menu .unity-base-dropdown__item {
    min-height: 26px;
    padding: 0 8px;
    border-radius: 8px;
}

.forge-menu .unity-base-dropdown__item:hover {
    background-color: var(--forge-accent-soft);
}

.forge-menu .unity-base-dropdown__label {
    font-size: 12px;
    color: var(--forge-text);
}

.forge-menu .unity-base-dropdown__checkmark {
    -unity-background-image-tint-color: var(--forge-accent);
}

.forge-menu .unity-base-dropdown__separator {
    background-color: var(--forge-border);
}

.forge-theme .unity-color-field__input {
    min-width: 46px;
}

.forge-theme .unity-color-field__color {
    border-radius: 5px;
}

/* ---------- Écriture du roman : messages et fenêtres de statut entre crochets ---------- */

.forge-theme .forge-system-title {
    margin-bottom: 8px;
    font-size: 12px;
    color: var(--forge-accent-text);
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular.ttf");
    -unity-font-style: normal;
}

.forge-theme .forge-issue .forge-mono {
    font-size: 11px;
}

/* Les blocs de la simulation sont des fenêtres de statut : cadre fin bleuté, comme les fenêtres système du roman. */
.forge-theme .forge-sim-block {
    border-radius: 12px;
    border-color: rgba(138, 168, 224, 0.28);
    border-top-color: rgba(138, 168, 224, 0.45);
    border-left-color: rgba(138, 168, 224, 0.45);
    background-color: rgba(16, 20, 32, 0.55);
}

.forge-theme .forge-sidebar__status.forge-mono {
    font-size: 10px;
}

/* ---------- En-têtes : de l'air entre fil d'Ariane, titre, sous-titre et description ---------- */

.forge-theme .forge-breadcrumb {
    margin-bottom: 4px;
}

.forge-theme .forge-title {
    margin-bottom: 5px;
}

.forge-theme .forge-details-title {
    margin-bottom: 8px;
}

.forge-theme .forge-details-header .forge-row {
    margin-bottom: 6px;
}

.forge-theme .forge-section-title {
    margin-bottom: 6px;
}

.forge-theme .forge-section-description {
    margin-top: 0;
}

/* ---------- Barres de défilement : fines et discrètes (elles ne doivent pas reprendre le style des curseurs) ---------- */

.forge-theme .unity-scroller {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.forge-theme .unity-scroller--vertical {
    width: 10px;
}

.forge-theme .unity-scroller--horizontal {
    height: 10px;
}

.forge-theme .unity-scroller .unity-repeat-button {
    display: none;
}

.forge-theme .unity-scroller .unity-base-slider__tracker {
    height: auto;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.forge-theme .unity-scroller .unity-base-slider__dragger,
.forge-theme .unity-scroller--horizontal .unity-base-slider--horizontal .unity-base-slider__dragger {
    margin: 2px;
    border-width: 0;
    border-radius: 3px;
    background-color: rgba(232, 238, 250, 0.18);
}

.forge-theme .unity-scroller .unity-base-slider__dragger:hover {
    background-color: rgba(232, 238, 250, 0.3);
}

.forge-theme .unity-scroller--horizontal .unity-base-slider__dragger {
    height: 6px;
    margin-top: 2px;
}

/* ---------- Énumérations : même champ sombre que les listes déroulantes ---------- */

.forge-theme .unity-enum-field__input,
.forge-theme .unity-base-popup-field__input {
    border-width: 1px;
    border-color: var(--forge-border);
    background-color: var(--forge-input);
    color: var(--forge-text);
}

.forge-theme .unity-enum-field__input:hover,
.forge-theme .unity-base-popup-field__input:hover {
    border-color: var(--forge-border-strong);
}

.forge-theme .unity-enum-field__text,
.forge-theme .unity-base-popup-field__text {
    color: var(--forge-text);
}

/* ---------- Pastille de couleur : toute la hauteur du champ ---------- */

.forge-theme .unity-color-field__color {
    flex-grow: 1;
    min-height: 16px;
}

/* ---------- Messages d'aide (HelpBox) : panneau arrondi teinté par l'état ---------- */

.forge-theme .unity-help-box {
    padding: 8px 12px;
    border-width: 1px;
    border-radius: 12px;
    border-color: rgba(231, 181, 47, 0.3);
    background-color: var(--forge-warning-soft);
}

.forge-theme .unity-help-box__label {
    color: var(--forge-text);
    white-space: normal;
}

/* Barre d'opacité sous la pastille de couleur : inutile ici (les couleurs sont opaques). */
.forge-theme .unity-color-field__color-container {
    overflow: hidden;
    border-radius: 6px;
}

/* Barres de la simulation et jauges : elles grandissent à l'ouverture du panneau (voir ChartAnimation.ReplayAll). */
.forge-bar__fill {
    transition-property: height, background-color;
    transition-duration: 0.45s, 0.15s;
    transition-timing-function: ease-out-cubic;
}

.forge-mini-meter__fill {
    transition-property: width;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-cubic;
}

/* ---------- Sélecteurs de vue (Dialogues…) : même groupe de verre que les catégories de Progression ---------- */

.forge-theme .forge-view-switch {
    padding: 4px;
    border-radius: 14px;
    border-color: var(--forge-border);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: var(--forge-bg-sidebar);
}

.forge-theme .forge-view-switch__button,
.forge-theme .forge-view-switch__button:hover {
    margin: 0;
    border-width: 0;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--forge-text-2);
}

.forge-theme .forge-view-switch__button:hover {
    color: var(--forge-text);
}

.forge-theme .forge-view-switch__button--active,
.forge-theme .forge-view-switch__button--active:hover {
    border-width: 1px;
    border-color: var(--forge-border);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: var(--forge-accent-soft);
    color: var(--forge-text);
    -unity-font-style: normal;
}

/* Zones de travail (plan des étages, graphe de dialogue) : verre sombre plutôt qu'un aplat noir. */
.forge-theme .forge-floor__board {
    border-radius: 18px;
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
}

/* ---------- Mise en page générale ---------- */

/* Filtres de liste : à distance du champ de recherche et de la liste. */
.forge-theme .forge-list-filters {
    margin: 2px 0 12px 0;
}

.forge-theme .forge-list-filters > * {
    margin-bottom: 6px;
}

.forge-theme .forge-details {
    padding-bottom: 18px;
}

/* Bouton « retirer » : la croix est dessinée au centre. */
.forge-theme .forge-button--close {
    width: 26px;
    min-width: 26px;
    height: 26px;
    min-height: 26px;
    padding: 0;
    justify-content: center;
    align-items: center;
    color: var(--forge-text-2);
}

.forge-theme .forge-button--close:hover {
    color: var(--forge-danger);
}

.forge-button__cross {
    width: 12px;
    height: 12px;
}

/* Bouton à symbole dessiné (flèches) : carré, symbole centré. */
.forge-theme .forge-button--glyph {
    width: 26px;
    min-width: 26px;
    height: 26px;
    min-height: 26px;
    padding: 0;
    justify-content: center;
    align-items: center;
    color: var(--forge-text-2);
}

.forge-theme .forge-button--glyph:hover {
    color: var(--forge-text);
}

.forge-button__glyph {
    width: 14px;
    height: 14px;
}

/* Choix de plusieurs étages : pastilles à cocher. */
.forge-floor-mask {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
}

.forge-floor-mask__chips {
    flex-direction: row;
    flex-wrap: wrap;
    flex-grow: 1;
}

.forge-theme .forge-floor-mask__chip {
    min-height: 24px;
    margin: 2px 6px 2px 0;
    padding: 0 12px;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--forge-border);
    background-color: rgba(255, 255, 255, 0.03);
    color: var(--forge-text-3);
}

.forge-theme .forge-floor-mask__chip:hover {
    color: var(--forge-text);
    border-color: var(--forge-border-strong);
}

.forge-theme .forge-floor-mask__chip--on,
.forge-theme .forge-floor-mask__chip--on:hover {
    border-color: var(--forge-accent);
    background-color: var(--forge-accent-soft);
    color: var(--forge-text);
}

/* ---------- Dialogues : actions, apparence ---------- */

.forge-theme .forge-dialogue-actions {
    margin: 4px 0 14px 0;
}

.forge-dialogue-look {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
    margin-top: 6px;
}

.forge-dialogue-look__fields {
    flex-grow: 1;
    flex-basis: 320px;
    margin-right: 18px;
}

.forge-theme .forge-dialogue-look__fields .forge-palette__title {
    margin-top: 10px;
    margin-bottom: 2px;
}

.forge-dialogue-sample {
    flex-grow: 1;
    flex-basis: 360px;
    margin-top: 12px;
    padding: 16px;
    border-radius: 14px;
    background-color: rgb(28, 25, 33);
}

.forge-dialogue-sample__box {
    flex-direction: row;
    padding: 12px;
    border-width: 2px;
    border-radius: 8px;
}

.forge-dialogue-sample__portrait {
    width: 64px;
    height: 64px;
    margin-right: 12px;
    border-width: 2px;
    border-radius: 6px;
    background-color: rgba(255, 255, 255, 0.05);
    flex-shrink: 0;
}

.forge-dialogue-sample__content {
    flex-grow: 1;
    flex-shrink: 1;
}

.forge-theme .forge-dialogue-sample__plate {
    align-self: flex-start;
    padding: 2px 12px;
    margin-bottom: 6px;
    border-radius: 4px;
    font-size: 11px;
    -unity-font-definition: url("Fonts/GothicA1-Bold.ttf");
}

.forge-theme .forge-dialogue-sample__text {
    white-space: normal;
    font-size: 12px;
    margin-bottom: 8px;
}

.forge-theme .forge-dialogue-sample__choice {
    margin-top: 4px;
    padding: 4px 10px;
    border-width: 1px;
    border-radius: 6px;
    font-size: 11px;
}

/* ---------- Dialogues : conversation et arbre côte à côte avec le détail de la réplique ---------- */

.forge-dialogue-layout__graph {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 360px;
    margin-right: 16px;
}

.forge-theme .forge-dialogue-layout__side {
    max-height: 720px;
}

.forge-dialogue-graph__toolbar {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.forge-theme .forge-dialogue-graph__toolbar .forge-chart__legend {
    margin: 0;
}

.forge-theme .forge-dialogue-graph__toolbar .forge-button {
    margin-left: 6px;
}

.forge-theme .forge-dialogue-graph__zoom {
    min-width: 44px;
    margin-right: 4px;
    font-size: 11px;
    color: var(--forge-text-3);
    -unity-text-align: middle-right;
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular.ttf");
}

.forge-theme .forge-dialogue-graph__viewport {
    height: 640px;
    overflow: hidden;
    border-width: 1px;
    border-radius: 16px;
    border-color: var(--forge-border);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: var(--forge-canvas);
}

.forge-dialogue-graph__content {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
}

.forge-dialogue-graph__edges {
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 1px;
}

.forge-theme .forge-dialogue-graph__hint {
    position: absolute;
    left: 14px;
    bottom: 10px;
    font-size: 10px;
    color: var(--forge-text-3);
}

/* Export PNG : fond opaque, sans coins arrondis ni aide. */
.forge-theme .forge-dialogue-graph--export .forge-dialogue-graph__viewport {
    border-width: 0;
    border-radius: 0;
    background-color: rgb(13, 13, 19);
}

.forge-dialogue-graph--export .forge-dialogue-graph__hint {
    display: none;
}

/* Une réplique de l'arbre */
.forge-theme .forge-dialogue-node {
    position: absolute;
    padding: 10px 12px 12px 12px;
    border-width: 1px;
    border-top-width: 3px;
    border-radius: 12px;
    border-left-color: var(--forge-border-strong);
    border-right-color: var(--forge-border-strong);
    border-bottom-color: var(--forge-border-strong);
    background-color: rgba(22, 22, 31, 0.94);
}

.forge-theme .forge-dialogue-node:hover {
    border-left-color: var(--forge-accent);
    border-right-color: var(--forge-accent);
    border-bottom-color: var(--forge-accent);
}

.forge-theme .forge-dialogue-node--selected,
.forge-theme .forge-dialogue-node--selected:hover {
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--forge-accent);
    border-right-color: var(--forge-accent);
    border-bottom-color: var(--forge-accent);
    background-color: rgba(30, 32, 48, 0.97);
}

.forge-theme .forge-dialogue-node--orphan {
    border-left-color: var(--forge-warning);
    border-right-color: var(--forge-warning);
    border-bottom-color: var(--forge-warning);
}

.forge-theme .forge-dialogue-node--drop {
    border-left-color: var(--forge-success);
    border-right-color: var(--forge-success);
    border-bottom-color: var(--forge-success);
    background-color: rgba(30, 48, 36, 0.97);
}

.forge-theme .forge-dialogue-node--narrator {
    background-color: rgba(18, 18, 24, 0.9);
}

.forge-dialogue-node__input {
    position: absolute;
    top: -9px;
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 6px;
    border-width: 2px;
    border-color: var(--forge-border-strong);
    background-color: rgb(22, 22, 31);
}

.forge-dialogue-node__header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 6px;
}

.forge-theme .forge-dialogue-node__speaker {
    font-size: 11px;
    color: var(--forge-text);
    margin-right: 6px;
    -unity-font-definition: url("Fonts/GothicA1-Bold.ttf");
}

.forge-theme .forge-dialogue-node__id {
    font-size: 10px;
    color: var(--forge-text-3);
    margin-right: 6px;
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular.ttf");
}

.forge-theme .forge-dialogue-node__text {
    white-space: normal;
    font-size: 11px;
    color: var(--forge-text-2);
}

.forge-theme .forge-dialogue-node--narrator .forge-dialogue-node__text {
    -unity-font-style: italic;
}

.forge-theme .forge-dialogue-node__effects {
    margin-top: 6px;
    font-size: 10px;
    color: var(--forge-warning);
}

.forge-dialogue-node__choices {
    margin-top: 8px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--forge-border);
}

.forge-dialogue-node__choice {
    flex-direction: row;
    align-items: center;
    min-height: 24px;
    margin-right: -12px;
}

.forge-theme .forge-dialogue-node__choice-text {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 11px;
    color: var(--forge-text);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.forge-theme .forge-dialogue-node__lock {
    margin-right: 5px;
    font-size: 8px;
    color: var(--forge-lavender);
}

.forge-dialogue-node__port {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    flex-shrink: 0;
}

.forge-dialogue-node__port:hover {
    width: 16px;
    height: 16px;
    border-radius: 8px;
}

.forge-dialogue-node__port--side {
    margin-left: 6px;
    margin-right: -7px;
}

.forge-dialogue-node__port--bottom {
    position: absolute;
    bottom: -8px;
    left: 50%;
    margin-left: -7px;
}

/* Carte de survol d'une réplique */
.forge-theme .forge-dialogue-card {
    position: absolute;
    width: 300px;
    padding: 12px 14px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--forge-border);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: rgba(16, 16, 24, 0.97);
}

.forge-dialogue-card__header {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 8px;
}

.forge-dialogue-card__dot {
    width: 8px;
    height: 8px;
    margin-right: 7px;
    border-radius: 4px;
}

.forge-theme .forge-dialogue-card__speaker {
    font-size: 12px;
    margin-right: 6px;
    -unity-font-definition: url("Fonts/GothicA1-Bold.ttf");
}

.forge-theme .forge-dialogue-card__id {
    font-size: 10px;
    margin-right: 6px;
    color: var(--forge-text-3);
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular.ttf");
}

.forge-theme .forge-dialogue-card__text {
    white-space: normal;
    font-size: 12px;
    color: var(--forge-text);
}

.forge-theme .forge-dialogue-card__title {
    margin-top: 10px;
    margin-bottom: 3px;
    font-size: 10px;
    color: var(--forge-text-3);
    -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold.ttf");
    letter-spacing: 1px;
}

.forge-dialogue-card__choice {
    margin-top: 4px;
    padding: 5px 8px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.03);
}

.forge-theme .forge-dialogue-card__choice-text {
    white-space: normal;
    font-size: 11px;
}

.forge-theme .forge-dialogue-card__next {
    margin-top: 10px;
    font-size: 11px;
    color: var(--forge-text-2);
}

.forge-theme .forge-dialogue-card__hint {
    margin-top: 10px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: var(--forge-border);
    font-size: 10px;
    color: var(--forge-text-3);
}

/* ---------- Dialogues : aperçu en jeu ---------- */

.forge-theme .forge-preview-game__hud {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
}

.forge-preview-game__stat {
    flex-direction: row;
    align-items: center;
    margin: 0 6px 6px 0;
    padding: 3px 10px;
    border-radius: 8px;
    background-color: rgba(0, 0, 0, 0.62);
}

.forge-theme .forge-preview-game__stat-label {
    margin-right: 6px;
    font-size: 10px;
    color: rgb(170, 168, 180);
}

.forge-theme .forge-preview-game__stat-value {
    font-size: 11px;
    color: rgb(240, 238, 232);
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular.ttf");
}

.forge-theme .forge-preview-game__stat--gold .forge-preview-game__stat-value {
    color: rgb(242, 204, 77);
}

.forge-theme .forge-preview-game__box {
    border-width: 2px;
}

.forge-theme .forge-preview-game__right .forge-palette__title {
    margin-top: 14px;
    margin-bottom: 4px;
}

.forge-theme .forge-preview-game__journal-title {
    margin-top: 18px;
}

.forge-theme .forge-preview-game__choice {
    border-width: 1px;
}

/* ---------- Arbre : réponses reliables des deux côtés ---------- */

.forge-dialogue-node__choice {
    margin-left: -12px;
}

.forge-dialogue-node__port--left {
    margin-left: -7px;
    margin-right: 6px;
}

.forge-dialogue-node__port--idle {
    opacity: 0.35;
}

/* ---------- Conditions et effets : le champ passe sous le type quand la place manque ---------- */

.forge-theme .forge-rule-row {
    flex-wrap: wrap;
}

.forge-theme .forge-rule-row__type {
    width: auto;
    min-width: 130px;
    flex-basis: 150px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 3px;
}

.forge-theme .forge-rule-row__value {
    min-width: 170px;
    flex-basis: 190px;
    flex-grow: 1;
    flex-shrink: 1;
    margin-bottom: 3px;
}

.forge-theme .forge-rule-row__value .forge-row > TextField {
    flex-grow: 1;
    flex-shrink: 1;
}

.forge-theme .forge-rule-row__value .forge-picker {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.forge-theme .forge-rule-row__value .forge-picker DropdownField {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

/* ---------- Champ sprite : boutons juste après le nom ---------- */

.forge-theme .forge-sprite-field__name {
    flex-grow: 0;
    flex-shrink: 1;
    max-width: 220px;
    margin-right: 12px;
}

.forge-theme .forge-sprite-field .forge-button {
    margin-right: 6px;
}

/* ---------- Boutons de la liste (Nouveau, Dupliquer, Supprimer) ---------- */

.forge-theme .forge-list-pane > .forge-toolbar > .forge-button {
    margin: 0 8px 8px 0;
}

/* ---------- Sections repliables ---------- */

.forge-section__header {
    flex-direction: row;
    align-items: center;
}

.forge-section__header > .forge-section-title {
    flex-grow: 1;
}

.forge-section__chevron {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex-shrink: 0;
}

.forge-section--collapsed > * {
    display: none;
}

.forge-section--collapsed > .forge-section__header {
    display: flex;
}

.forge-theme .forge-section--collapsed > .forge-section__header .forge-section-title {
    margin-bottom: 0;
}

.forge-theme .forge-section--collapsed {
    padding-top: 12px;
    padding-bottom: 12px;
}

.forge-section__header--toggle:hover .forge-section-title {
    color: var(--forge-accent-text);
}

.forge-theme .forge-section__header {
    margin-bottom: 6px;
}

.forge-theme .forge-section__header > .forge-section-title {
    margin-bottom: 0;
}

.forge-theme .forge-section--collapsed > .forge-section__header {
    margin-bottom: 0;
}

.forge-theme .forge-section__chevron {
    color: var(--forge-text-3);
}

.forge-theme .forge-section__header--toggle:hover .forge-section__chevron {
    color: var(--forge-text);
}

/* ---------- Liste des éléments : un espace entre chaque ligne ---------- */

.forge-theme .forge-list-pane .unity-collection-view__item,
.forge-theme .forge-list-pane .unity-collection-view__item:hover,
.forge-theme .forge-list-pane .unity-collection-view__item--selected,
.forge-theme .forge-list-pane .unity-collection-view__item--selected:hover {
    background-color: rgba(0, 0, 0, 0);
}

.forge-list-item__slot {
    justify-content: center;
    height: 100%;
}

.forge-theme .forge-list-pane .forge-list-item {
    height: 26px;
    border-radius: 10px;
}

.forge-theme .forge-list-pane .unity-collection-view__item:hover .forge-list-item {
    background-color: var(--forge-hover);
}

.forge-theme .forge-list-pane .unity-collection-view__item--selected .forge-list-item,
.forge-theme .forge-list-pane .unity-collection-view__item--selected:hover .forge-list-item {
    background-color: var(--forge-accent-soft);
}

/* Loupe dessinée de la barre de recherche */
.forge-theme .unity-toolbar-search-field .forge-search-icon {
    width: 16px;
    height: 16px;
    opacity: 1;
    color: var(--forge-text-3);
    background-image: none;
}

.forge-theme .forge-dialogue-inspector__replies {
    margin-top: 14px;
}

.forge-theme .forge-dialogue-discussion > .forge-dialogue-actions {
    margin-top: 10px;
}


.forge-theme .unity-toolbar-search-field .unity-search-field-base__search-button.forge-search-icon {
    width: 10px;
    height: 10px;
    margin: 0 6px 0 0;
    align-self: center;
}

.forge-theme .unity-toolbar-search-field.unity-search-field-base {
    padding-left: 8px;
}

/* ---------- Blocs : même espacement partout, en-tête de même hauteur replié ou non ---------- */

.forge-theme .forge-details .forge-section,
.forge-theme .forge-details .forge-details-header {
    margin: 0 0 12px 0;
}

.forge-theme .forge-section .forge-section {
    margin: 10px 0 0 0;
}

.forge-section__header {
    min-height: 28px;
}

/* Le bouton « + Ajouter » d'un bloc n'apparaît que quand le bloc est déplié. */
.forge-section--collapsed > .forge-section__header > .forge-button {
    display: none;
}

/* Texte des réponses du joueur : centré verticalement dans son champ. */
.forge-theme .forge-dialogue-choice TextField .unity-text-element {
    -unity-text-align: middle-left;
}

.forge-theme .forge-dialogue-choice TextField .unity-base-text-field__input {
    min-height: 28px;
    padding-top: 4px;
    padding-bottom: 4px;
    justify-content: center;
}

/* Marque de la barre latérale : nom puis sous-titre, avec un peu d'air. */
.forge-theme .forge-sidebar__tagline {
    margin-top: 5px;
    white-space: normal;
}

/* Barre de validation plus large : l'état et les boutons ont de la place. */
.forge-theme .forge-footer {
    width: 70%;
    min-width: 560px;
    max-width: 1000px;
    min-height: 46px;
    padding: 8px 8px 8px 18px;
}

.forge-theme .forge-footer__status {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 16px 0 8px;
}

.forge-theme .forge-footer .forge-button {
    margin-left: 8px;
    padding-left: 16px;
    padding-right: 16px;
}

/* ---------- Raretés (Objets > Raretés) et effets actifs / passifs ---------- */
.forge-rarity-card > .forge-row {
    margin-bottom: 4px;
}

.forge-rarity-card .forge-row > .forge-badge,
.forge-rarity-card .forge-row > .forge-button {
    flex-shrink: 0;
    margin-left: 6px;
}


.forge-theme .forge-rarity-orphans {
    white-space: normal;
    margin: 4px 0 8px 0;
    padding: 6px 10px;
    border-radius: 10px;
    color: var(--forge-danger);
    background-color: var(--forge-danger-soft);
}

.forge-theme .forge-rarity-field--missing .unity-base-popup-field__text {
    color: var(--forge-danger);
}

.forge-effect-trigger {
    width: 96px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-right: 6px;
}

.forge-theme .forge-effect-trigger--passive .unity-base-popup-field__text {
    color: var(--forge-lavender);
}

/* ---------- Modifications non validées (barre latérale) : bouton « Tout valider » ---------- */
.forge-theme .forge-sidebar__unsaved {
    margin-top: -6px;
    border-color: var(--forge-lavender-soft);
}

.forge-theme .forge-sidebar__unsaved:hover {
    border-color: var(--forge-lavender);
    background-color: var(--forge-hover);
}

.forge-theme .forge-sidebar__unsaved--blocked,
.forge-theme .forge-sidebar__unsaved--blocked:hover {
    border-color: var(--forge-danger-soft);
}

/* ---------- Raretés : poignée de glisser-déposer (coin haut gauche de la carte) ---------- */
.forge-drag-handle {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    margin-right: 10px;
    cursor: move-arrow;
}

.forge-theme .forge-drag-handle {
    color: var(--forge-text-2);
}

/* Glisser-déposer (ForgeReorder) : les autres cartes glissent pour ouvrir la place visée. */
.forge-reorder-item {
    transition-property: translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

/* Place de la carte déplacée : estompée et bordée, en attendant le lâcher. */
.forge-theme .forge-reorder--placeholder {
    opacity: 0.35;
    border-color: var(--forge-lavender);
}

.forge-theme .forge-reorder-ghost {
    padding: 12px 16px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--forge-lavender);
}

.forge-reorder-ghost__swatch {
    width: 20px;
    height: 20px;
    margin-right: 10px;
    border-radius: 6px;
}

.forge-theme .forge-reorder-ghost__name {
    -unity-font-style: bold;
}

.forge-theme .forge-rarity-card--new {
    border-color: var(--forge-lavender);
}

/* Liste des modifications non validées (appui long sur l'indicateur). */
.forge-theme .forge-unsaved-menu {
    padding: 8px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--forge-border-strong);
    border-top-color: var(--forge-rim);
    border-left-color: var(--forge-rim);
    background-color: var(--forge-bg-sidebar);
}

.forge-theme .forge-unsaved-menu__title {
    margin: 2px 6px 6px 6px;
    color: var(--forge-text-2);
    font-size: 11px;
}

.forge-theme .forge-unsaved-menu__row {
    padding: 7px 10px;
    border-radius: 9px;
}

.forge-theme .forge-unsaved-menu__row--hover {
    background-color: var(--forge-accent-soft);
}

.forge-theme .forge-unsaved-menu__commit {
    margin-top: 6px;
    border-top-width: 1px;
    border-top-color: var(--forge-border);
}

/* ---------- Ennemis : vue « Comportement » (règles, éditeur, arène) ---------- */
.forge-behaviour {
    flex-direction: row;
    align-items: flex-start;
}

.forge-behaviour__rules {
    width: 320px;
    flex-shrink: 0;
    margin-right: 12px;
}

.forge-behaviour__main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.forge-theme .forge-rule-card {
    margin: 0 0 6px 0;
    padding: 8px 10px 8px 6px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
}

.forge-theme .forge-rule-card:hover {
    border-color: var(--forge-border-strong);
}

.forge-theme .forge-rule-card--selected,
.forge-theme .forge-rule-card--selected:hover {
    border-color: var(--forge-lavender);
    background-color: var(--forge-accent-soft);
}

.forge-theme .forge-rule-card--otherwise {
    margin-top: 4px;
    padding-left: 12px;
    border-style: solid;
    background-color: rgba(0, 0, 0, 0);
}

.forge-theme .forge-rule-card__number {
    flex-shrink: 0;
    margin-right: 8px;
    padding: 2px 9px;
    border-radius: 10px;
    background-color: var(--forge-lavender-soft);
    color: var(--forge-text);
    -unity-font-style: bold;
}

.forge-theme .forge-rule-card__name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--forge-text);
    -unity-font-style: bold;
}

.forge-theme .forge-rule-card__line {
    margin: 3px 0 0 6px;
    white-space: normal;
    font-size: 11px;
    color: var(--forge-text-2);
}

/* Pastille verte : la règle qui s'applique dans l'arène de test. */
.forge-rule-card__dot {
    width: 9px;
    height: 9px;
    flex-shrink: 0;
    margin-left: 8px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.08);
}

.forge-theme .forge-rule-card--active .forge-rule-card__dot {
    background-color: var(--forge-success);
}

.forge-theme .forge-rule-editor__name .unity-base-text-field__input {
    font-size: 15px;
    -unity-font-style: bold;
}

.forge-theme .forge-rule-editor__heading {
    margin: 16px 0 8px 0;
    color: var(--forge-lavender);
    font-size: 13px;
    -unity-font-style: bold;
}

.forge-theme .forge-rule-editor__warning {
    margin: 0 0 4px 0;
    white-space: normal;
    font-size: 11px;
    color: var(--forge-warning);
}

.forge-rule-editor__group {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
}

.forge-theme .forge-rule-editor__label {
    width: 96px;
    flex-shrink: 0;
    margin-top: 8px;
    color: var(--forge-text-2);
}

/* Conditions et réglages en pastilles : « joueur à moins de [3] cases ✕ ». */
.forge-chips {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.forge-theme .forge-chip {
    flex-direction: row;
    align-items: center;
    min-height: 30px;
    margin: 0 8px 8px 0;
    padding: 2px 4px 2px 12px;
    border-width: 1px;
    border-radius: 15px;
    border-color: var(--forge-lavender-soft);
    background-color: rgba(165, 151, 192, 0.12);
}

.forge-theme .forge-chip--setting {
    padding-right: 12px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
}

.forge-theme .forge-chip--empty {
    padding-right: 12px;
    font-size: 12px;
    color: var(--forge-text-2);
    border-style: dashed;
    background-color: rgba(0, 0, 0, 0);
}

.forge-theme .forge-chip__text {
    margin: 0 4px;
    color: var(--forge-text);
}

.forge-chip__group {
    flex-direction: row;
    align-items: center;
}

.forge-theme .forge-chip__field {
    width: 56px;
    flex-grow: 0;
    margin: 0 2px;
}

.forge-theme .forge-chip__field--wide {
    width: 150px;
}

.forge-theme .forge-chip__remove {
    margin-left: 4px;
}

.forge-theme .forge-chip-add {
    min-height: 30px;
    margin: 0 8px 8px 0;
    border-radius: 15px;
    border-style: dashed;
}

/* Actions en tuiles illustrées. */
.forge-tiles {
    flex-direction: row;
    flex-wrap: wrap;
}

.forge-theme .forge-action-tile {
    width: 96px;
    height: 74px;
    margin: 0 8px 8px 0;
    padding: 6px 4px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
    color: var(--forge-text-2);
}

.forge-theme .forge-action-tile:hover {
    border-color: var(--forge-border-strong);
    color: var(--forge-text);
}

.forge-theme .forge-action-tile--selected,
.forge-theme .forge-action-tile--selected:hover {
    border-color: var(--forge-lavender);
    background-color: var(--forge-accent-soft);
    color: var(--forge-text);
}

.forge-action-tile__icon {
    width: 46px;
    height: 30px;
    margin-bottom: 6px;
}

.forge-theme .forge-action-tile__label {
    font-size: 11px;
    -unity-text-align: middle-center;
    color: var(--forge-text-2);
}

.forge-theme .forge-action-tile--selected .forge-action-tile__label {
    color: var(--forge-text);
}

/* Arène de test. */
.forge-theme .forge-arena__canvas {
    height: 280px;
    margin: 6px 0 8px 0;
    border-radius: 12px;
    overflow: hidden;
}

.forge-arena__icon {
    position: absolute;
}

.forge-theme .forge-arena__status {
    margin-bottom: 8px;
    white-space: normal;
}

.forge-theme .forge-arena__controls {
    margin-top: 4px;
}

/* Valeurs d'attaque côté ennemi : grisées = celles de l'attaque (clic pour remplacer), lavande = remplacées pour cet ennemi. */
.forge-theme .forge-chip--inherited {
    opacity: 0.6;
    border-style: dashed;
}

.forge-theme .forge-chip--inherited:hover {
    opacity: 1;
    border-color: var(--forge-lavender);
}

.forge-theme .forge-chip__inherited {
    margin: 0 4px;
    padding: 2px 6px;
    color: var(--forge-text-2);
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular.ttf");
}

.forge-theme .forge-chip--overridden {
    border-color: var(--forge-lavender);
    background-color: rgba(165, 151, 192, 0.18);
}

.forge-theme .forge-chip__reset {
    width: 22px;
    min-width: 22px;
    height: 22px;
    min-height: 22px;
    margin-left: 4px;
    padding: 0;
    border-radius: 11px;
}

/* Frise du rythme d'une attaque. */
.forge-timeline {
    margin: 2px 0 6px 0;
}

.forge-theme .forge-timeline__bar {
    flex-direction: row;
    align-items: stretch;
    height: 26px;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--forge-surface-raised);
}

.forge-timeline__segment {
    justify-content: center;
    min-width: 0;
    overflow: hidden;
}

.forge-theme .forge-timeline__label {
    margin: 0 6px;
    font-size: 10px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--forge-text);
}

.forge-theme .forge-timeline__windup { background-color: rgba(231, 181, 47, 0.45); }
.forge-theme .forge-timeline__recovery { background-color: rgba(158, 189, 133, 0.35); }
.forge-theme .forge-timeline__cooldown { background-color: rgba(120, 140, 190, 0.25); }

.forge-theme .forge-timeline__hit {
    width: 4px;
    background-color: #e0606a;
}

/* ---------- Attaques : étapes ---------- */
.forge-theme .forge-step-card {
    margin: 0 0 10px 0;
    padding: 10px 12px;
    border-width: 1px;
    border-radius: 14px;
    border-color: var(--forge-border);
    background-color: var(--forge-surface-raised);
}

.forge-theme .forge-step-card__when {
    margin: 8px 0;
    padding: 8px 10px;
    border-radius: 10px;
    background-color: rgba(165, 151, 192, 0.08);
}

.forge-theme .forge-step-card__trigger {
    width: 280px;
    flex-grow: 0;
    margin: 0 8px 6px 4px;
}

.forge-step-card__details {
    flex-direction: row;
    align-items: flex-start;
}

.forge-step-card__fields {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.forge-theme .forge-step-preview {
    width: 220px;
    height: 140px;
    flex-shrink: 0;
    margin: 6px 0 0 12px;
    border-radius: 10px;
    background-color: rgba(7, 8, 12, 0.6);
}

.forge-theme .forge-tiles--small .forge-action-tile {
    height: 60px;
}

.forge-theme .forge-step-line {
    margin: 2px 0;
    white-space: normal;
}

.forge-theme .forge-timeline__segment--conditional {
    opacity: 0.55;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.35);
    border-left-width: 0;
    border-right-width: 0;
}

.forge-timeline__label {
    -unity-text-align: middle-center;
}

/* Options d'une étape (« + Option ») : une ligne par option utilisée. */
.forge-step-options {
    margin-top: 6px;
}

.forge-theme .forge-step-option {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin: 0 0 6px 0;
    padding: 4px 6px 0 10px;
    border-width: 1px;
    border-radius: 12px;
    border-color: var(--forge-lavender-soft);
    background-color: rgba(165, 151, 192, 0.06);
}

.forge-theme .forge-step-option__name {
    width: 170px;
    flex-shrink: 0;
    margin-bottom: 6px;
    color: var(--forge-lavender);
    -unity-font-style: bold;
}

/* Chance d'une attaque d'être lancée dans la situation de l'arène. */
.forge-theme .forge-rule-card__chance {
    flex-shrink: 0;
    margin-left: 6px;
    font-size: 11px;
    color: var(--forge-text-3);
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular.ttf");
}

.forge-theme .forge-rule-card--active .forge-rule-card__chance {
    color: var(--forge-success);
    -unity-font-style: bold;
}
